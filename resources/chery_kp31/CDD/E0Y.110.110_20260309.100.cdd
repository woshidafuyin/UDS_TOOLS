<UNSDEF id='_0000013D19A01E40' oid='E6B1436E96D2400185A4DFE725E2FF6D' temploid='EC7686F6ED7A4faaA742041EFEA81BFC' attrcatref='_0000013D79C2C090' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority.</TUV>
</DESC>
<QUAL>Diagnostic_CAN.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19A02220' oid='231ED964A4214e088C9686BED51F5199' temploid='418AC10E68CC48c38096757D606611D6' attrcatref='_0000013D79C2C090' usage='sys' v='1536' df='hex'>
