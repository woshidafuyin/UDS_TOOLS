<UNSDEF id='_0000013D19AEDB70' oid='8DB3C8C6CB0A4b6fB40F2AE16D7614EC' temploid='25BBB28344604a279EBE9B6FF8913191' attrcatref='_0000013D79C2C090' usage='sys' v='16000' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for functionally addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>Comfort_CAN.TesterPresentFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AED980' oid='3B4428FAFCDD48e1A72DD72EC93606EC' temploid='5894F84563FE4695A1FDEB4C1DEA7EFD' attrcatref='_0000013D79C2C770' usage='sys' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames.Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds.Values from 0xF1 to 0xF9 are even 100 micro seconds.Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>Comfort_CAN.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEE330' oid='8ECBA20C55294e1e810FC153B3F4EF10' temploid='A6011D350D2D41c89BE8340CEE506E99' attrcatref='_0000013D79C2C090' usage='sys' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>Comfort_CAN.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEDF50' oid='2461F65CDD8A46c3B90420B64DC33130' temploid='9479A6F86DDB4e558596A47513880B70' attrcatref='_0000013D79C2C770' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEE520' oid='8B2274D967A64214B4E2BD7A8EE09E8B' temploid='B63C7C7140BE4b95844706149002F291' attrcatref='_0000013D79C2C770' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEEAF0' oid='A94876B7190D43a2835BF111FECBE896' temploid='947663BA2FBB422a961CFE234B2E5E9B' attrcatref='_0000013D79C2C770' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Bs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEEED0' oid='4AEDBA4D77C94f63854E1F6465E566B7' temploid='05A3248BE91B459885223E8A7DA805EF' attrcatref='_0000013D79C2C770' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Br</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEF0C0' oid='5EFE9A024D0943a7873A020F58F4EC1B' temploid='534360BC006F48c7824C6B165357740D' attrcatref='_0000013D79C2C770' usage='sys' v='100' df='dec'>
