<CASE oid='dbe80f6a5bf85fae96ea819f7dde171b' s='0' e='0'>
<STRUCTURE>
<DATAOBJ oid='3bacd43acc6b5cbaba9da40ef6297f50' spec='no' dtref='_0000013D19BBCB60'>
<NAME>
<TUV xml:lang='en-US'>Driving Cycles Until "Check Engine" Lamp Off</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Counts the number of driving cycles until "Check Engine" lamp will be switched off if the driving cycle can be performed in a fault free mode</TUV>
</DESC>
<QUAL>Driving_Cycles_Until_Check_Engine_Lamp_Off</QUAL>
</DATAOBJ>
<DATAOBJ oid='dc613219b6055e908082263b5c73018f' spec='no' dtref='_0000013D19BBCB60'>
<NAME>
<TUV xml:lang='en-US'>Malfunction Indicator Counter</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Counts the number of engine operating hours during which the OBD system operated with a malfunction active (DTC B1)</TUV>
</DESC>
<QUAL>Malfunction_Indicator_Counter</QUAL>
</DATAOBJ>
</STRUCTURE>
</CASE>
<CASE oid='af871447241e5fc9b9d3ba40d1347833' s='10' e='10'>
<STRUCTURE>
<DATAOBJ oid='cc3a483067605fb8af02adfdd5d8e279' spec='no' dtref='_0000013D19BBCB60'>
<NAME>
<TUV xml:lang='en-US'>Driving Cycles Since Test Failed</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Counts the number of driving cycles in which "test failed" has been reported</TUV>
</DESC>
<QUAL>Driving_Cycles_Since_Test_Failed</QUAL>
</DATAOBJ>
</STRUCTURE>
</CASE>
<CASE oid='c73612cd35045a3f867f59c589acc98e' s='11' e='11'>
<STRUCTURE>
<DATAOBJ oid='ef66ff6d0e245fbb997089350b609814' spec='no' dtref='_0000013D19BBCB60'>
<NAME>
<TUV xml:lang='en-US'>Driving Cycles Since Last Failed</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Counts the number of driving cycles since the test last failed</TUV>
</DESC>
<QUAL>Driving_Cycles_Since_Last_Failed</QUAL>
</DATAOBJ>
</STRUCTURE>
</CASE>
<CASE oid='a7a2d224d3ed50529dad9ee7560aa80f' s='12' e='12'>
<STRUCTURE>
<DATAOBJ oid='e6bb055965fb569392b4beea6ec9a1a8' spec='no' dtref='_0000013D19BBCB60'>
<NAME>
<TUV xml:lang='en-US'>Driving Cycles Since Last Completed</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Counts the number of driving cycles since the test was last completed, i.e. reported "test passed" or "test failed"</TUV>
</DESC>
<QUAL>Driving_Cycles_Since_Last_Completed</QUAL>
</DATAOBJ>
</STRUCTURE>
</CASE>
