</NAME>
<QUAL>Powertrain_CAN</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000013D19AE1B30' oid='8E3BB764145D4d87A0A6F971BEAD0C72' temploid='B1754AC4E666458b8546D21DE12EC546' attrcatref='_0000013D79C2C090' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media</TUV>
</DESC>
<QUAL>Powertrain_CAN.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>CAN</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000013D19AE31B0' oid='C74AC8E483A54550AD1693974C3EDA2B' temploid='5C7EAB3F59C74e60BBA06DDC63DBC236' attrcatref='_0000013D79C2C090' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>Powertrain_CAN.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
