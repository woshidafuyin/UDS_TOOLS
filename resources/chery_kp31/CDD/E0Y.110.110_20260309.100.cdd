</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEF2B0' oid='305528D44FAC428696EAC991FD511F1D' temploid='EC2132D4DC2C40249FDBABB85D9D5FA0' attrcatref='_0000013D79C2C770' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Cr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AEF4A0' oid='A9C7AA96338641979D0CC8F748F9A7E9' temploid='43C510AD042048aaBF3D662D3D294707' attrcatref='_0000013D79C2C090' usage='sys' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>Comfort_CAN.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AD08A0' oid='05EF5E864A0C4d3bA2F306B904F6592E' temploid='45F103E859A24d1e9D5D2DA902609B30' attrcatref='_0000013D79C2C090' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>Comfort_CAN.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000013D19AD0A90' oid='186CCD604A0642d99AA37E2DF999A083' temploid='C25B68D25F214ae9AD8348C0B538461B' attrcatref='_0000013D79C2C090' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>Comfort_CAN.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000013D19AE2850' oid='5DA19BCCBB924141895DB57112130EBF' temploid='F5B1FA24E9CC4436BFE57871BF3FD7EB' attrcatref='_0000013D79C2C090' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>Comfort_CAN.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000013D19AE20D0' oid='F42C022ED5F14cc39A715877FCDB53D0' temploid='716091F1BBD843efB13EFB411587E4BF' attrcatref='_0000013D79C2D320' usage='sys' v='0' sort='id'>
<NAME>
