void HalAndRsa(byte data[],dword length)//计算signature
{
  //驱动函数的hal
  dword i,j;
  dword temp[0x200000];
  dword input[0x200000];
  byte  RSAdata[128]; //补齐128byte
  
  j = 0;
  for(i = 0;i < length;i++)
  {
    temp[i] = data[i] & 0x000000FF;
  }
  
  for(i = 0;i < length/4;i++)
  {
    input[i] = (temp[4*j] << 24) + (temp[4*j + 1] << 16) + (temp[4*j + 2] << 8) + temp[4*j + 3];
    j++;
  }
  
  //hal_Cal(input,Signature.Data_20,length);
      
  //RSA加密
  RSAdata[0] = 0x00;
  RSAdata[1] = 0x01;
  for(i = 2;i < 92;i++)
  {
    RSAdata[i] = 0xFF;
  }
  
  RSAdata[92] = 0x00;
  
  RSAdata[93]  = 0x30;
  RSAdata[94]  = 0x21;
  RSAdata[95]  = 0x30;
  RSAdata[96]  = 0x09;
  RSAdata[97]  = 0x06;
  RSAdata[98]  = 0x05;
  RSAdata[99]  = 0x2b;
  RSAdata[100] = 0x0e;
  RSAdata[101] = 0x03;
  RSAdata[102] = 0x02;
  RSAdata[103] = 0x1a;
  RSAdata[104] = 0x05;
  RSAdata[105] = 0x00;
  RSAdata[106] = 0x04;
  RSAdata[107] = 0x14;
  
  for(i = 108;i<128;i++)
  {
    RSAdata[i] = Signature.Data_20[i-108];
  }
  //RSA_Cal(RSAdata,privatekey,128,mod,128,Signature.Data_128);
}


/// <Server>
server_31(byte response,dword id,byte Subfunction,dword RID,dword data,dword flag)
{
  int i;
  dword length;
  length =0 ;
  
    Tx_Data[length++] = 0x31;
    Tx_Data[length++] = Subfunction;
    if(flag == 0) //擦除内存
    {
      Tx_Data[length++] = (byte)((RID >> 8) & 0xFF);
      Tx_Data[length++] = (byte)( RID       & 0xFF);
      Tx_Data[length++] = 0x44;
      Tx_Data[length++] = 0xC0;//楚航
      Tx_Data[length++] = 0x08;//楚航
      Tx_Data[length++] = 0x00;//楚航
      Tx_Data[length++] = 0x00;//楚航
      Tx_Data[length++] = 0x00;;//楚航
      Tx_Data[length++] = 0x0F;//楚航
      Tx_Data[length++] = 0x50;//楚航
      Tx_Data[length++] = 0x00;//楚航
    }
    if(flag == 1) //校验
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);
      
      //128byte signature生成
      
      for(i = 0;i < 512;i++)
      {
        Tx_Data[length++] = Signature.Data_128[i];
      }
    }
    if(flag == 2) //只发DID
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);
    }
    if(flag == 3)
    {
      Tx_Data[length++] = (byte)((RID >> 8) & 0xFF);
      Tx_Data[length++] = (byte)( RID       & 0xFF);
      Tx_Data[length++] = 0x44;
      Tx_Data[length++] = 0xC0;
      Tx_Data[length++] = 0x18;
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0x00;//
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0xC8;
    }
        if(flag == 4)//错误的擦除地址
    {
      Tx_Data[length++] = (byte)((RID >> 8) & 0xFF);
      Tx_Data[length++] = (byte)( RID       & 0xFF);
      Tx_Data[length++] = 0x44;
      Tx_Data[length++] = 0xC0;
      Tx_Data[length++] = 0x18;
      Tx_Data[length++] = 0xFF;
      Tx_Data[length++] = 0xFF;//
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0x00;
      Tx_Data[length++] = 0xC8;
    }
  
  TxMsgSrever(response,id,length,Tx_Data);
    
  if(g_Rx.byte(5) != 0x00)  //肯定响应参数为0x00时，pass
  {
    if(RID != 0xD005)
    {
      testStepFail("fail","Routine Completed unsuccessfully");
    }
    else
    {
      if(g_Rx.byte(5) != 0x01)
      {
        testStepFail("fail","Routine Completed unsuccessfully");
      }
    }
  }
}
