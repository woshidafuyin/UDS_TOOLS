on timer test_online
{
  server_3e(0x00,gFunId,0x80,0x02);
  setTimer(test_online,S3server);
}

on message *
{
  if(this.id == gResId)
  {
    g_Rx.id      = this.id;
    g_Rx.byte(0) = this.byte(0); 
    g_Rx.byte(1) = this.byte(1);
    g_Rx.byte(2) = this.byte(2); 
    g_Rx.byte(3) = this.byte(3);
    g_Rx.byte(4) = this.byte(4); 
    g_Rx.byte(5) = this.byte(5);
    g_Rx.byte(6) = this.byte(6); 
    g_Rx.byte(7) = this.byte(7);
    PrintMsgReceive(g_Rx);
    
    if(g_Rx.byte(1) == 0x67 && g_Rx.byte(2) == 0x01)
    {
      seed_L1[0] = g_Rx.byte(3);
      seed_L1[1] = g_Rx.byte(4);
    }
    if(g_Rx.byte(1) == 0x67 && g_Rx.byte(2) == 0x07)
    {
      seed_L2[0] = g_Rx.byte(3);
      seed_L2[1] = g_Rx.byte(4);
    }
  }
  if(this.id == gPhyId)
  {
    if(this.byte(1) == 0x27)
    {
      g_Tx.id      = this.id;
      g_Tx.byte(0) = this.byte(0); 
      g_Tx.byte(1) = this.byte(1);
      g_Tx.byte(2) = this.byte(2); 
      g_Tx.byte(3) = this.byte(3);
      g_Tx.byte(4) = this.byte(4); 
      g_Tx.byte(5) = this.byte(5);
      g_Tx.byte(6) = this.byte(6); 
      g_Tx.byte(7) = this.byte(7);    
      PrintMsgOutput(g_Tx);
    }
  }
}

void PrintMsgOutput(message* msg)
{
  testStep("Tx","[%x] [%.2x %.2x %.2x %.2x %.2x %.2x %.2x %.2x]",
  msg.id,msg.byte(0),msg.byte(1),msg.byte(2),msg.byte(3),msg.byte(4),msg.byte(5),msg.byte(6),msg.byte(7)); 
}

void PrintMsgReceive(message* msg)
{
  testStep("Rx","[%x] [%.2x %.2x %.2x %.2x %.2x %.2x %.2x %.2x]",
  msg.id,msg.byte(0),msg.byte(1),msg.byte(2),msg.byte(3),msg.byte(4),msg.byte(5),msg.byte(6),msg.byte(7)); 
}

byte CharToHex(char s[],int index)
{
  long WriteData;
  char src[5] = "0x";
  
  src[2] = s[index*3]; 
  src[3] = s[index*3 + 1];
  
  strtol(src,WriteData);
  
  return WriteData;
}

void output_FC()
{
  g_Tx.id      = gPhyId;
  g_Tx.byte(0) = 0x30;
  g_Tx.byte(1) = 0x00;
  g_Tx.byte(2) = 0x00;
  g_Tx.byte(3) = 0x55;
  g_Tx.byte(4) = 0x55;
  g_Tx.byte(5) = 0x55;
  g_Tx.byte(6) = 0x55;
  g_Tx.byte(7) = 0x55;
  output(g_Tx);
  PrintMsgOutput(g_Tx);
}

void output_StayInBoot()
{
  g_Tx.id      = gPhyId;
  g_Tx.byte(0) = 0x04;
  g_Tx.byte(1) = 0x31;
  g_Tx.byte(2) = 0x01;
  g_Tx.byte(3) = 0xDD;
  g_Tx.byte(4) = 0x01;
  g_Tx.byte(5) = 0x55;
  g_Tx.byte(6) = 0x55;
  g_Tx.byte(7) = 0x55;
  output(g_Tx);
  PrintMsgOutput(g_Tx);
}

nodeDropErrorHandling(long silent)
{
  long channel = 1;
  switch(silent)
  {
    case 0:{testStepPass("nodeDrop","nodeDropError");};break;
    case 1:{testStepPass("nodeDrop","nodeDropErrorRecovery");};break;
  }
  canSetChannelOutput(channel, silent);
}

void JudgeResponse(byte response,dword service)
{
  if(response == 0)  //不期待接收到响应
  {
    if(0 == testWaitForMessage(gResId,50))
    {
      testStepPass("pass","%x Service dosn't response anything",service);
    }
    else
    {
      if(g_Rx.byte(3) == 0x78 || g_Rx.byte(1) == 0x7e)
      {
        while(1)
        {
            if(1 == testWaitForMessage(gResId ,5000))
            {
                if(g_Rx.byte(3) == 0x78)
                {
                  testStep("wait","%x Service returns response pending:[0x%x] ",service,g_Rx.byte(3));
                }
                else
                {
                  g_Data.State = MsgFalse;
                  testStepFail("fail","%x Service returns negative response:[0x%x] ",service,g_Rx.byte(3));
                  break;
                }
              }
            else
            {
              break;
            }
        }
        testStepPass("pass","%x Service has NRC78",service);
      }
      else
      {
        g_Data.State = MsgFalse;
        testStepFail("fail1","%.2x Service responsed anything",service);
      }
    }
  }
  else  //期望接收到响应
  {
    if(response == service + 0x40)  //肯定响应
    {
      if(1 == testWaitForMessage(gResId,200))
      {
        if(g_Rx.byte(1) == response)  //单帧响应
        {
          testStepPass("pass","%s service has postive response",service);
        }
        else if(g_Rx.byte(2) == response)   //多帧响应，需发送流控帧
        {
          testStepPass("pass","%s service has postive response",service);
          output_FC();
          while(1)  //等待CF传输完毕
          {
            if(0 == testWaitForMessage(gResId,128))  //等待连续帧接收完毕，才执行其他步骤
            {
              testStepPass("pass","%x service return successive frames",service);
              break;
            }
          }
        }
        else if(g_Rx.byte(2) == service && g_Rx.byte(3) != 0x78) //否定响应
        {
          g_Data.State = MsgFalse;
          testStepFail("fail","%s service has negative response:[0x%x],hope to receive response:[0x%x]",service ,g_Rx.byte(3),response);
        }
        else if(g_Rx.byte(3) == 0x78)
        {
          while(1)  //可能接收到多次NRC78,除接收到NRC78之外的数据，均可跳出该循环
          {
            if(1 == testWaitForMessage(gResId ,5000))
            {
              if(g_Rx.byte(1) == response)
              {
                testStepPass("pass","%s service has postive response",service);
                break;
              }
              else if(g_Rx.byte(2) == response)
              {
                testStepPass("pass","%s service has postive response",service);
                output_FC();
                while(1)  //等待CF传输完毕
                {
                  if(0 == testWaitForMessage(gResId,128))  //等待连续帧接收完毕，才执行其他步骤
                  {
                    testStepPass("pass","%x service return successive frames",service);
                    break;
                  }
                }
              }
              else
              {
                if(g_Rx.byte(3) == 0x78)
                {
                  testStep("wait","%x Service returns response pending:[0x%x] ",service,g_Rx.byte(3));
                  
                  if(routine == 1) //进行通讯中断
                  {
                    nodeDropErrorHandling(0);
                    testWaitForTimeout(500);
                    g_Data.state = MsgFalse;
                    nodeDropErrorHandling(1);
                    break;
                  }
                  
                }
                else
                {
                  g_Data.State = MsgFalse;
                  testStepFail("fail","%x Service returns negative response:[0x%x],hope to receive response:[0x%x]",service,g_Rx.byte(3),response);
                  break;
                }
              }
            }
            else
            {
              g_Data.State = MsgFalse;
              testStepFail("fail","%x Service dosn't response anything after pending:[0x%x],hope to receive response:[0x%x]",service,0x78,response);
              break;
            }
          }
        }
      }
      else
      {
        g_Data.State = MsgFalse;
        testStepFail("fail","%x has no response",service);
      }
    }
    else  //其他类型响应（NRC）
    {
      if(1 == testWaitForMessage(gResId,500))
      {
        if(g_Rx.byte(1) == 0x7F)  //xx 7F service nrc
        {
          if(g_Rx.byte(3) == 0x78)
          {
            while(1)  //可能接收到多次NRC78,除接收到NRC78之外的数据，均可跳出该循环
            {
              if(1 == testWaitForMessage(gResId ,5000))
              {
                if(g_Rx.byte(1) != 0x7F)
                {
                  testStepFail("Fail","no except response");
                  break;
                }
                else
                {
                  if(g_Rx.byte(3) == response)
                  {
                   break;
                   testStepPass("Pass","");
                  }
                  else
                  {
                    if(g_Rx.byte(3) != 0x78)
                    {
                       break;
                       testStepFail("Fail","no except response");
                    }
                  }
                }
              }
              else
              {break;}
            }
          }
          else
          {
            if(g_Rx.byte(3) == response)
            {
              g_Data.State = MsgFalse;
              testStepPass("pass","%x Service returns negative response:[0x%x]",service ,g_Rx.byte(3));
            }
            else
            {
              g_Data.State = MsgFalse;
              testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x] ",service,g_Rx.byte(3),response);
            }
          }
          
          
        }
        else                      //不知名服务
        {
          g_Data.State = MsgFalse;
          testStepFail("fail","%x Service returns response:[0x%x] ",service ,g_Rx.byte(1));
        }
        
      }
      else
      {
        g_Data.State = MsgFalse;
        testStepFail("fail","%x has no response",service);
      }
    }
  }
}

void TxTPData(dword id,dword length,dword data[],dword serve)
{
  int cur_cf_number,cur_data_number;
  int sent_cf_n;
  int i,TempLen;
  int accepted_fc_n;
  
  
  g_Tx.id       = id;
  sent_cf_n     = 0;
  TempLen       = 0;
  accepted_fc_n = 0;
  
  cur_cf_number = length/0x07;
  cur_data_number = length - 0x06;
  
  
  if(1 == testWaitForMessage(gResId,150))
  {
    g_Tx.byte(0) = 0x21;
    if(g_Rx.byte(0) == 0x30)
    {
      accepted_fc_n++;
      while(sent_cf_n < cur_cf_number)
      {
        for(i = 1; i <= 0x07; i++)
        {
          if(TempLen < cur_data_number)
          {
            g_Tx.byte(i) = data[TempLen];
            TempLen++;
            
            if(download_progress_flag == 1)
            {
              transform_data++;
            }
          }
          else
          {
            g_Tx.byte(i) = 0x55;
          }
        }
        if(g_Rx.byte(1) != 0x00)
        {
          if(abs(sent_cf_n - (accepted_fc_n * g_Rx.byte(1))) == 0)
          {
            if(1 == testWaitForMessage(gResId,150))
            {
              if(g_Rx.byte(0) == 0x30)
              {
                accepted_fc_n++;
              }
            }
            else
            {
              testStepFail("fail","No CF was received!");
              break;
            }
          }
        }
        
        output(g_Tx);
        
        if(serve != 0x36)
        {
          PrintMsgOutput(g_Tx);
        }
        
        sent_cf_n++;
        
        if(g_Tx.byte(0) == 0x2F)
        {
          g_Tx.byte(0) = 0x1F;
        }
        g_Tx.byte(0)++;
      }
      if(download_progress_flag == 1)
      {
        putvalue(Download,(((float)(transform_data)) / FileLen)*100);
        putvalue(FlashRate,(((float)(transform_data)) / FileLen)*100);
      }
   }
  }
}

void TxMsgSrever(byte response,dword id,dword length,dword Data[])
{
  int i,j,tp_data_n;
  dword tp_Data[4096];
  tp_data_n = 0;
  g_Tx.id = id;
    
  if((0x00 < length) && (length < 0x08))//单帧
  {
    g_Tx.byte(0) = length;
    for(i = 0 ; i < length ; i++)
    {
      g_Tx.byte(i+1) = Data[i];
    }
    for(i = length + 1 ; i < 0x08 ; i++)
    {
      g_Tx.byte(i) = 0x55;
    }
    output(g_Tx);
    PrintMsgOutput(g_Tx);
  }
  else if((0x07 < length) && (length <= 0xfff))//首帧
  {
    g_Tx.byte(0) = 0x10 + ((length >> 8) & 0xFF);
    g_Tx.byte(1) = length & 0xFF;
    for(i = 0;i < 0x06;i++)
    {
     g_Tx.byte(i+2) = Data[i];
    }
    output(g_Tx);
    PrintMsgOutput(g_Tx);
    for(i = 6 ;i < length ;i++)
    {
      tp_Data[tp_data_n] = Data[i];
      tp_data_n++;
    }    
    TxTPData(id,length,tp_Data,Data[0]);
  }
  
  JudgeResponse(response,Data[0]);
  
  testWaitForTimeout(50);
  
}

/// <Server>
server_3e(byte response,dword id,byte Subfunction,byte length)
{
  int i;
  g_server3E.id = id;
  g_server3E.byte(0) = length;
  g_server3E.byte(1) = 0x3E;
  for(i = 2 ;i < 0x08 ;i++)
  {
    g_server3E.byte(i) = 0x55;
  }
  
  if(length == 0x02)
  {
    g_server3E.byte(2) = Subfunction;
  }
  if(length > 0x02)
  {
    g_server3E.byte(2) = Subfunction;
    for(i = 3;i <= length;i++)
    {
      g_server3E.byte(i) = 0x01;
    }
  }
  output(g_server3E);
  PrintMsgOutput(g_server3E);
  if(response != 0 || id == gPhyId)
  {
    JudgeResponse(response,0x3E);
  }
}

/// <Init>
void ResetAllValue()
{
  long Curtime[8];
  int i;
  
  g_Data.State = MsgTrue;
  
  download_progress_flag = 0;
  transform_data = 0;
  
  putValue(Download,0);
  putValue(FlashRate,0);
  putValue(FlashTime,0);
  ResetFlag = 0;
  
  getMeasurementStartTime(Curtime);
  
  fingerdata[0] = ((((Curtime[6] + 1900)%100)/10)*16) + ((Curtime[6] + 1900)%100)%10;//年
  fingerdata[1] = ((Curtime[5] + 1)/10)*16 + (Curtime[5] + 1)%10;//月
  fingerdata[2] = (Curtime[4]/10)*16 + Curtime[4]%10;//日
    
  for(i = 3;i < 19;i++)
  {
    fingerdata[i] = 0xFF;
  }
  
  FileLen = 0x0F5000;
}

/// <Init>
char HexToChar(char buff)
{
  if((buff >= 0x30) && (buff <= 0x39))
  {
    buff -= 0x30;
  }
  else if((buff >= 0x41) &&(buff <= 0x46))
  {
    buff -= 0x37;
  }
  else if((buff >= 0x61) && (buff <= 0x66))
  {
    buff -= 0x57;
  }
  else
  {
    buff = 0xFF;
  }
  return buff;
}

/// <Init>
byte FileCheckSum(dword  buff[],dword len)
{
  dword i;
  byte Sum;
  Sum    = 0x00;
  for(i = 0 ;i < len ;i++)
  {
    Sum += buff[i];
  }
  Sum = (byte)(0xFF - Sum);
  return Sum;
}

/// <Init>
void FileInit()
{
  dword i;
  dword j;
  dword k;
  char  FilePath1[200];//驱动程序
  dword FileHandle1;
  
  char  FilePath2[200];//APP程序
  dword FileHandle2;
  
  char  FilePath3[200];//CAL程序
  dword FileHandle3;
  
  
  char  cbuf[200];//驱动程序
  long  copiedBytes;
  
  char  Buff[256];
  dword Data[256];
  
  
  dword FileRow;        //文件的行数
  
  byte  TempLen;
  dword CurrentrowAdressLen;
  int   status;
  dword CurrentrowStartaddress;
  dword byte_addr;
  
  
  FileRow                = 0;
  CurrentrowAdressLen    = 0;
  CurrentrowStartaddress = 0;
  
 // testWaitForEnvVar(Flash_set,0);
  
  
  for(i = 8; i < 0x0408;i++)
  {
    g_Data.buffDriver[i] = 0xFF;
  }
  
  
  //首先解析驱动程序
  getValue(FilePath_Driver,FilePath1);
  FileHandle1 = openFileRead(FilePath1,0);  //打开文件进行读取（0：ASCII ,1：binary）
  
  if(FileHandle1 != 0)
  {
    while(fileGetString(Buff,elCount(Buff),FileHandle1) != 0)
    {
      if((Buff[0] == 'S') && ((Buff[1] == '1') ||(Buff[1] == '2') ||(Buff[1] == '3')))
      {
        FileRow++;
        TempLen = (byte)((HexToChar(Buff[2]) << 4) + HexToChar(Buff[3]) + 1);  //该行的总长度
        CurrentrowAdressLen = HexToChar(Buff[1]) + 1;
        for(i = 0;i < TempLen ;i++)
        {
          Data[i] = (byte)((HexToChar(Buff[(i + 1)*2]) << 4) + HexToChar(Buff[(i + 1)*2 + 1]));
          
          if(i == 4)
          {
            if(((Data[1] << 24) + (Data[2] << 16) + (Data[3] << 8) + Data[4]) < 0x08000000)
            {
              status = 1;
              break;
            }
          }
          status = 0;
        }
        if(status == 1)
        {
          continue;
        }
        
        if(Data[TempLen - 1] == FileCheckSum(Data,TempLen -1))
        {
          CurrentrowStartaddress = 0;
          
          for(i = 0;i < CurrentrowAdressLen;i++)//数据的地址
          {
            CurrentrowStartaddress += Data[i+1] << (8 * (CurrentrowAdressLen - i - 1));
          }
          for(i = 0;i < (TempLen - 2 - CurrentrowAdressLen);i++)
          {
            byte_addr = CurrentrowStartaddress + i;
            g_Data.buffDriver[byte_addr - 0x08000000 + 8] = Data[i + CurrentrowAdressLen + 1]; //前面八个字节用于存放地址跟长度
          }
        }
        else
        {
          testStepFail("fail","%d line checksum error!",FileRow);
        }
      }
    }
  }
  fileClose(FileHandle1);

  
  //解析APP报文
  FileRow                = 0;
  CurrentrowAdressLen    = 0;
  CurrentrowStartaddress = 0;
  
  for(i = 8 ; i < 0x0F5008;i++)
  {
     g_Data.buff[i] = 0xFF;
  }
  
  getValue(FilePath,FilePath2);
  FileHandle2 = openFileRead(FilePath2,0);  //打开文件进行读取（0：ASCII ,1：binary）
  
  if(FileHandle2 != 0)
  {
    while(fileGetString(Buff,elCount(Buff),FileHandle2) != 0)
    {
      if((Buff[0] == 'S') && ((Buff[1] == '1') ||(Buff[1] == '2') ||(Buff[1] == '3')))
      {
        FileRow++;
        TempLen = (byte)((HexToChar(Buff[2]) << 4) + HexToChar(Buff[3]) + 1);  //该行的总长度
        CurrentrowAdressLen = HexToChar(Buff[1]) + 1;
        for(i = 0;i < TempLen ;i++)
        {
          Data[i] = (byte)((HexToChar(Buff[(i + 1)*2]) << 4) + HexToChar(Buff[(i + 1)*2 + 1])); //以字节形式存放
          
          if(i == 4)
          {
            if(((Data[1] << 24) + (Data[2] << 16) + (Data[3] << 8) + Data[4]) < 0xC0080000)
            {
              status = 1;
              break;
            }
          }
          status = 0;
        }
        if(status == 1)
        {
          continue;
        }
        if(Data[TempLen - 1] == FileCheckSum(Data,TempLen -1))
        {
          CurrentrowStartaddress = 0;
          for(i = 0;i < CurrentrowAdressLen ;i++)
          {
            CurrentrowStartaddress += Data[i+1] << (8*(CurrentrowAdressLen -1-i));
          }
          for(i = 0;i < TempLen -(CurrentrowAdressLen + 2);i++) //数据长度
          {
            byte_addr = CurrentrowStartaddress + i;
            g_Data.buff[byte_addr - 0xC0080000 + 8] = Data[i + CurrentrowAdressLen + 1];
          }
        }
        else
        {
          testStepFail("fail","%d line checksum error!",FileRow);
        }
      }
    }
  }
  fileClose(FileHandle2);
  
  
  //解析CAL报文
  FileRow                = 0;
  CurrentrowAdressLen    = 0;
  CurrentrowStartaddress = 0;
  
  for(i = 8 ; i < 208;i++)
  {
     g_Data.bufCal[i] = 0xFF;
  }
  
  getValue(FilePath_Cal,FilePath3);
  FileHandle3 = openFileRead(FilePath3,0);  //打开文件进行读取（0：ASCII ,1：binary）
  
  if(FileHandle3 != 0)
  {
    while(fileGetString(Buff,elCount(Buff),FileHandle3) != 0)
    {
      if((Buff[0] == 'S') && ((Buff[1] == '1') ||(Buff[1] == '2') ||(Buff[1] == '3')))
      {
        FileRow++;
        TempLen = (byte)((HexToChar(Buff[2]) << 4) + HexToChar(Buff[3]) + 1);  //该行的总长度
        CurrentrowAdressLen = HexToChar(Buff[1]) + 1;
        for(i = 0;i < TempLen ;i++)
        {
          Data[i] = (byte)((HexToChar(Buff[(i + 1)*2]) << 4) + HexToChar(Buff[(i + 1)*2 + 1])); //以字节形式存放
          
          if(i == 4)
          {
            if(((Data[1] << 24) + (Data[2] << 16) + (Data[3] << 8) + Data[4]) < 0xC0180000)
            {
              status = 1;
              break;
            }
          }
          status = 0;
        }
        if(status == 1)
        {
          continue;
        }
        if(Data[TempLen - 1] == FileCheckSum(Data,TempLen -1))
        {
          CurrentrowStartaddress = 0;
          for(i = 0;i < CurrentrowAdressLen ;i++)
          {
            CurrentrowStartaddress += Data[i+1] << (8*(CurrentrowAdressLen -1-i));
          }
          for(i = 0;i < TempLen -(CurrentrowAdressLen + 2);i++) //数据长度
          {
            byte_addr = CurrentrowStartaddress + i;
            g_Data.bufCal[byte_addr - 0xC0180000+8] = Data[i + CurrentrowAdressLen + 1];
          }
        }
        else
        {
          testStepFail("fail","%d line checksum error!",FileRow);
        }
      }
    }
  }
  fileClose(FileHandle3);
  
  
  
}

/// <Init>
void driverData()
{
  dword i;
  dword j;
  dword k;
  
  char  FilePath3[200];//驱动程序校验值
  dword FileHandle3;
  
  char  FilePath4[200];//APP程序校验值
  dword FileHandle4;
  
  char  Buff1[3000];
  char  Buff2[3000];
  
  k = 0;
  j = 0;
  getValue(FilePath_Draver_data,FilePath3);
  FileHandle3 = openFileRead(FilePath3,0);
  if(FileHandle3 != 0)
  {
    while(fileGetString(Buff1,elCount(Buff1),FileHandle3) != 0)
    {
      for(i = 0;i < strlen(Buff1);i++)
      {

        if(Buff1[i] == ' ')
        {
          continue;
        }
        if(Buff1[i] != ',')
        {
          Buff2[j++] = Buff1[i];
        }
        if(j == 4)
        {
          Signature.Data_128[k++] = atol(Buff2);
          j = 0;
        }
      }
    }
  }
  fileClose(FileHandle3);
}
