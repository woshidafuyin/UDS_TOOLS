testcase TC_7()
{
    testCaseDescription("tc_7");
    FileInit();
    testWaitForTimeout(1000);

    putValueToControl("FlashChery","CAPL Output View","Enter Extended session-进入扩展会话");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_10(0x50,gPhyId,0x03);

    putValueToControl("FlashChery","CAPL Output View","Check Programming Prog-检查编程环境");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_31(0x71,gPhyId,0x01,0x0203,0,2);

    putValueToControl("FlashChery","CAPL Output View","Enter Programming session-进入编程会话");
    putValueToControl("FlashChery","CAPL Output View",1,1); 
    server_10(0x50,gPhyId,0x02);

    putValueToControl("FlashChery","CAPL Output View","Process Security Access-解密");
    putValueToControl("FlashChery","CAPL Output View",1,1); 
    server_27();
  
    if(getValue(Update_PublicKey) == 0x01)
    {
        putValueToControl("FlashChery","CAPL Output View","Write VerifKey-写入验签秘钥");
        putValueToControl("FlashChery","CAPL Output View",1,1);  
        server_2E(0x6E,gPhyId,0x6F00,publickeydata,514); 
    }
    
    putValueToControl("FlashChery","CAPL Output View","Write Fingerprint-写入指纹信息");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_2E(0x6E,gPhyId,0xF184,fingerdata,19);
  
    fileData();

    testWaitForTimeout(2000);
    
    putValueToControl("FlashChery","CAPL Output View","Request Download-请求驱动下载");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_34(0x74,gPhyId,0x08000000,0x0400);
    
    putValueToControl("FlashChery","CAPL Output View","Transfer Data-驱动下载");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_36(0x76,gPhyId,0x0400,block_length,g_Data.buffDriver,0x00);
    
    putValueToControl("FlashChery","CAPL Output View","Transfer Exit-驱动下载完成");
    putValueToControl("FlashChery","CAPL Output View",1,1); 
    server_37(0x77,gPhyId,0x00);

    //HalAndRsa(g_Data.buffDriver,0x00000408);//RSA加密,结果值存放在Signature.Data_128[128]里
    driverData();
    testWaitForTimeout(2000);
    putValueToControl("FlashChery","CAPL Output View","check Routine-驱动软件校验");
    putValueToControl("FlashChery","CAPL Output View",1,1); 
    server_31(0x71,gPhyId,0x01,0xDD02,0,1);//最后1：校验
    
    
    testWaitForTimeout(2000);
    putValueToControl("FlashChery","CAPL Output View","Routine Control – erase Memory-擦除内存");
    putValueToControl("FlashChery","CAPL Output View",1,1);      
    server_31(0x71,gPhyId,0x01,0xFF00,0,3);//最后0：擦除Cal
    
    putValueToControl("FlashChery","CAPL Output View","Request Download-请求标定软件下载");
    putValueToControl("FlashChery","CAPL Output View",1,1);
    server_34(0x74,gPhyId,0xC0180000,0x000000C8);
    
    putValueToControl("FlashChery","CAPL Output View","Transfer Data-标定软件下载");
    putValueToControl("FlashChery","CAPL Output View",1,1); 
    server_36(0x76,gPhyId,0x000000C8,block_length,g_Data.bufCal,0x00);
    
    putValueToControl("FlashChery","CAPL Output View","Request Transfer Exit-标定软件下载完成");
    putValueToControl("FlashChery","CAPL Output View",1,1);   
    server_37(0x77,gPhyId,0x00);

    CALData();
    testWaitForTimeout(2000);
    putValueToControl("FlashChery","CAPL Output View","check Routine-标定软件校验");
    putValueToControl("FlashChery","CAPL Output View",1,1); 
    server_31(0x71,gPhyId,0x01,0xDD02,0,1);//最后1：校验
    
    testWaitForTimeout(2000);
    putValueToControl("FlashChery","CAPL Output View","Routine Control–checkProgrammingDependencies-检查编程依赖性");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_31(0x71,gPhyId,0x01,0xFF01,0,2);//最后2:只发送DID

    putValueToControl("FlashChery","CAPL Output View","[FlashFileInstallation");
    putValueToControl("FlashChery","CAPL Output View",1,1);  
    server_31(0x71,gPhyId,0x01,0xDD03,0,2);
    
