/// <Server>
void server_27()
{
  byte gSeedArray[16];
  int gSeedArraySize    = 16;
  int gSecurityLevel    = 0x11;
  char gVariant[200]    = "";
  char gOption[200]     = "";
  byte gKeyArray[255];
  int  gMaxKeyArraySize = 255;
  dword gActualSizeOut     = 0;
  char gDebugBuffer[2000];

  
  diagSetTarget("E0Y");
  diagSendRequest(gSeedReq);
  testWaitForDiagResponse(gSeedReq, 100);
  diagGetLastResponse(gSeedReq, gSeedResp);
  diagGetParameterRaw(gSeedResp, "SecuritySeed", gSeedArray, elcount(gSeedArray)); 
  write("E0Y seed is %x%x%x%x",gSeedArray[0],gSeedArray[1],gSeedArray[2],gSeedArray[3]);
 
  if(0 == diagGenerateKeyFromSeed(gSeedArray, gSeedArraySize, gSecurityLevel, gVariant, gOption, gKeyArray, gMaxKeyArraySize, gActualSizeOut))
  {
    write("E0Y key is %x%x%x%x",gKeyArray[0],gKeyArray[1],gKeyArray[2],gKeyArray[3]);
    diagSetParameterRaw(gKeyReq, "SecurityKey", gKeyArray, gActualSizeOut);
    diagSendRequest(gKeyReq);
    testWaitForDiagRequestSent(gKeyReq, 50);
    testWaitForDiagResponse(gSeedReq, 50);
    testWaitForTimeout(50);
  }
}

/// <Server>
void server_2E(byte response,dword id,dword DID,dword DataRecord[],dword len)
{
