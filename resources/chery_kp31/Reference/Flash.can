  }

  TxMsgSrever(response,id,length,Tx_Data);
}

/// <Server>
void server_34(byte response,dword id,dword DataStartAddress,dword DataLen)
{
  dword length;
  length      = 0;
  
  Tx_Data[length++] = 0x34;
  Tx_Data[length++] = 0x00;
  Tx_Data[length++] = 0x44;
  Tx_Data[length++] = (byte)((DataStartAddress >> 24) & 0xFF);
  Tx_Data[length++] = (byte)((DataStartAddress >> 16) & 0xFF);
  Tx_Data[length++] = (byte)((DataStartAddress >>  8) & 0xFF);
  Tx_Data[length++] = (byte)((DataStartAddress)       & 0xFF);
  Tx_Data[length++] = (byte)((DataLen          >> 24) & 0xFF);
  Tx_Data[length++] = (byte)((DataLen          >> 16) & 0xFF);
  Tx_Data[length++] = (byte)((DataLen          >>  8) & 0xFF);
  Tx_Data[length++] = (byte)((DataLen)                & 0xFF);
  
  TxMsgSrever(response,id,length,Tx_Data);
  
  block_length = (g_Rx.byte(5) <<8) + g_Rx.byte(6);
}

/// <Server>
void server_36(byte response,dword id,dword allDataLen,dword blockLen,byte buffData[],dword extraData)
{
  dword i,k,j;
  dword length;
  dword blockNum;
  dword lastBlockLen;
  
  dword DataBlockLen[5000];
  dword BlockData[5000][4096];
  dword blockIndex;
  
  blockNum = 0;
  lastBlockLen = 0;
  length = 0;
  j = 0;
  
  if(allDataLen == 0x0F5000)//进行APP下载
  {
    download_progress_flag = 1;
    write("appflash");
  }
  
  blockNum = allDataLen/(blockLen - 2);
    
  if((allDataLen % (blockLen - 2)) != 0)
  {
    lastBlockLen = allDataLen%(blockLen - 2) + 2;//剩余数据加上36与块序列
    blockNum++;
  }
  
  //将数据存储起来
  
  for(i = 1;i <= blockNum;i++)
  {
    //计算每一块数据长度
    if(i<blockNum)
    {
      DataBlockLen[i] = blockLen - 2;
    }
    else
    {
      if(lastBlockLen != 0)
      {
        DataBlockLen[i] = lastBlockLen - 2;
      }
      else
      {
        DataBlockLen[i] = blockLen - 2;
      }
    }
    
    //对每一块数据进行赋值
    for(k = 0;k < DataBlockLen[i];k++)
    {
      BlockData[i][k] = buffData[8 + (j++)];
    }
  }
  //传输数据
  
  for(blockIndex = 1; blockIndex <= blockNum;blockIndex++)
  {
    length = 0;
    Tx_Data[length++] = 0x36;
    Tx_Data[length++] = blockIndex;
    for(i = 0;i < DataBlockLen[blockIndex];i++)
    {
      Tx_Data[length++] =  BlockData[blockIndex][i];
    }
    TxMsgSrever(response,id,length,Tx_Data);
  }
  
  if(allDataLen == 0x0F5000)
  {
     putvalue(Download,100);
     putvalue(FlashRate,100);
     download_progress_flag = 0;
  }
}

/// <Server>
void server_36_1(byte response,dword id,dword allDataLen,dword blockLen,byte buffData[],dword extraData)
{
  dword i,k,j;
  dword length;
  dword blockNum;
  dword lastBlockLen;
  
  dword DataBlockLen[500];
  dword BlockData[500][4096];
  dword blockIndex;
  int sendSpecBlockNum=3;
  
  blockNum = 0;
  lastBlockLen = 0;
  length = 0;
  j = 0;
  
  if(allDataLen == 0x0F5000)//进行APP下载
  {
    download_progress_flag = 1;
    write("appflash");
  }
  
  blockNum = allDataLen/(blockLen - 2);
    
  if((allDataLen % (blockLen - 2)) != 0)
  {
    lastBlockLen = allDataLen%(blockLen - 2) + 2;//剩余数据加上36与块序列
    blockNum++;
  }
  
  //将数据存储起来
  
  for(i = 1;i <= blockNum;i++)
  {
    //计算每一块数据长度
    if(i<blockNum)
    {
      DataBlockLen[i] = blockLen - 2;
    }
    else
    {
      if(lastBlockLen != 0)
      {
        DataBlockLen[i] = lastBlockLen - 2;
      }
      else
      {
        DataBlockLen[i] = blockLen - 2;
      }
    }
    
    //对每一块数据进行赋值
    for(k = 0;k < DataBlockLen[i];k++)
    {
      BlockData[i][k] = buffData[8 + (j++)];
    }
  }
  //传输数据
  
  for(blockIndex = 1; blockIndex <= blockNum;blockIndex++)
  {
    length = 0;
    Tx_Data[length++] = 0x36;
    Tx_Data[length++] = blockIndex;
    for(i = 0;i < DataBlockLen[blockIndex];i++)
    {
      Tx_Data[length++] =  BlockData[blockIndex][i];
    }
    TxMsgSrever(response,id,length,Tx_Data);
    if(blockIndex==2 )//blockinde==2时再发2次
    {
        for(sendSpecBlockNum=0;sendSpecBlockNum<1;sendSpecBlockNum++)
        {
            TxMsgSrever(response,id,length,Tx_Data);
        }
        
        
    }
  }
  
  if(allDataLen == 0x0F5000)
  {
     putvalue(Download,100);
     putvalue(FlashRate,100);
     download_progress_flag = 0;
  }
}

/// <Server>
void server_37(byte response,dword id,dword extraData)
{
  dword length;
  length = 0;
  
  if(extraData == 0x00)
  {
    Tx_Data[length++] = 0x37;
  }
  else
  {
    Tx_Data[length++] = 0x37;
    Tx_Data[length++] = extraData;
  }
  
  TxMsgSrever(response,id,length,Tx_Data);
}

/// <Server>
void server_11(byte response,dword id,byte subfunction)
{
  dword length;
  length = 0;
  
    Tx_Data[length++] = 0x11;
    Tx_Data[length++] = subfunction;
  
  TxMsgSrever(response,id,length,Tx_Data);
  testWaitForTimeout(2000);
}
/// <Server>
void server_14(byte response,dword id)
{
  dword length;
  length = 0;
  
    Tx_Data[length++] = 0x14;
    Tx_Data[length++] = 0xFF;
    Tx_Data[length++] = 0xFF;
    Tx_Data[length++] = 0xFF;
  
  TxMsgSrever(response,id,length,Tx_Data);
  testWaitForTimeout(2000);
}


