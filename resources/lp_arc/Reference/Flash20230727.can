    server_31(0x71,gPhyId,0x01,0x6000,0,4);//最后3：检查文件合法性
    
    if(g_Rx.byte(5) != 0x06)
    {
      testStepFail("Fail","ned receive 0x06,cur receive:%d",g_Rx.byte(5));
    }
    
    server_31(0x71,gPhyId,0x01,0x6001,0,2);//最后4：检查版本
    
    if(g_Rx.byte(5) != 0x05)
    {
      testStepFail("Fail","ned receive 0x05,cur receive:%d",g_Rx.byte(5));
    }
      
    server_2E(0x22,gPhyId,0xF198,Serial,16);
    
    server_2E(0x22,gPhyId,0xF199,fingerdata,4);
    
    server_34(0x22,gPhyId,DriverStartAdress,DriverLength);    
  }
  
  ReadVerSion(); //此函数用于读取VerCheck[]
  if(VerCheck[1061] >0x30)
  {
    testStep("","修改byte6");
    VerCheck[1061] = VerCheck[1061] - 1 ;
    
    VerCheck[1062] = VerCheck[1062] + 1 ;
    
    server_31(0x71,gPhyId,0x01,0x6000,0,4);//最后3：检查文件合法性
    
    if(g_Rx.byte(5) != 0x06)
    {
      testStepFail("Fail","ned receive 0x06,cur receive:%d",g_Rx.byte(5));
    }
    
    server_31(0x71,gPhyId,0x01,0x6001,0,2);//最后4：检查版本
    
    if(g_Rx.byte(5) != 0x05)
    {
      testStepFail("Fail","ned receive 0x05,cur receive:%d",g_Rx.byte(5));
    }
      
    server_2E(0x22,gPhyId,0xF198,Serial,16);
    
    server_2E(0x22,gPhyId,0xF199,fingerdata,4);
    
    server_34(0x22,gPhyId,DriverStartAdress,DriverLength);    
  }
  
  ReadVerSion(); //此函数用于读取VerCheck[]
  if(VerCheck[1062] >0x30)
  {
    testStep("","修改byte7");
    VerCheck[1062] = VerCheck[1062] - 1 ;
    server_31(0x71,gPhyId,0x01,0x6000,0,4);//最后3：检查文件合法性
    
    if(g_Rx.byte(5) != 0x06)
    {
      testStepFail("Fail","ned receive 0x06,cur receive:%d",g_Rx.byte(5));
    }
    
    server_31(0x71,gPhyId,0x01,0x6001,0,2);//最后4：检查版本
    
    if(g_Rx.byte(5) != 0x05)
    {
      testStepFail("Fail","ned receive 0x05,cur receive:%d",g_Rx.byte(5));
    }
      
    server_2E(0x22,gPhyId,0xF198,Serial,16);
    
    server_2E(0x22,gPhyId,0xF199,fingerdata,4);
    
    server_34(0x22,gPhyId,DriverStartAdress,DriverLength);    
  }
  
}


