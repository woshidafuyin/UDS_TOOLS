/// <Server>
void server_27(byte response,dword id,byte subfunction,byte flag)
{
  dword length;
  byte  Seed_Key[4] = {0,0,0,0};
  length = 0;
  
  if(subfunction == 0x11)
  {
    Tx_Data[length++] = 0x27;
    Tx_Data[length++] = subfunction;
  }
  if(subfunction == 0x12)
  {
    if(flag == 0)
    {
      Cal_key(0x11,seed_L2,Seed_Key);
      write("%x %x %x %x",seed_L2[0],seed_L2[1],seed_L2[2],seed_L2[3]);
      write("%x %x %x %x",Seed_Key[0],Seed_Key[1],Seed_Key[2],Seed_Key[3]);
    }
    else
    {
      Seed_Key[0] = 0;
    }
    Tx_Data[length++] = 0x27;
    Tx_Data[length++] = subfunction;
    
    Tx_Data[length++] = Seed_Key[0];
    Tx_Data[length++] = Seed_Key[1];
    Tx_Data[length++] = Seed_Key[2];
    Tx_Data[length++] = Seed_Key[3];
  }
  TxMsgSrever(response,id,length,Tx_Data);
}

/// <Server>
void server_2E(byte response,dword id,dword DID,dword DataRecord[],dword len)
{
  dword length;
  int   i;
  int   saveData;
  length = 0;
  saveData = 0;
  
  Tx_Data[length++] = 0x2E;
  Tx_Data[length++] = (DID >> 8) & 0xFF ;
  Tx_Data[length++] =  DID       & 0xFF;
  
  for(i = 0;i < len;i++)
  {
    Tx_Data[length++] = DataRecord[i];
  }

  TxMsgSrever(response,id,length,Tx_Data);
}


