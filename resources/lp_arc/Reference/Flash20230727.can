       0xFED41B76, 0x89D32BE0, 0x10DA7A5A, 0x67DD4ACC,
       0xF9B9DF6F, 0x8EBEEFF9, 0x17B7BE43, 0x60B08ED5,
       0xD6D6A3E8, 0xA1D1937E, 0x38D8C2C4, 0x4FDFF252,
       0xD1BB67F1, 0xA6BC5767, 0x3FB506DD, 0x48B2364B,
       0xD80D2BDA, 0xAF0A1B4C, 0x36034AF6, 0x41047A60,
       0xDF60EFC3, 0xA867DF55, 0x316E8EEF, 0x4669BE79,
       0xCB61B38C, 0xBC66831A, 0x256FD2A0, 0x5268E236,
       0xCC0C7795, 0xBB0B4703, 0x220216B9, 0x5505262F,
       0xC5BA3BBE, 0xB2BD0B28, 0x2BB45A92, 0x5CB36A04,
       0xC2D7FFA7, 0xB5D0CF31, 0x2CD99E8B, 0x5BDEAE1D,
       0x9B64C2B0, 0xEC63F226, 0x756AA39C, 0x026D930A,
       0x9C0906A9, 0xEB0E363F, 0x72076785, 0x05005713,
       0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38,
       0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21,
       0x86D3D2D4, 0xF1D4E242, 0x68DDB3F8, 0x1FDA836E,
       0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
       0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C,
       0x8F659EFF, 0xF862AE69, 0x616BFFD3, 0x166CCF45,
       0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2,
       0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB,
       0xAED16A4A, 0xD9D65ADC, 0x40DF0B66, 0x37D83BF0,
       0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
       0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6,
       0xBAD03605, 0xCDD70693, 0x54DE5729, 0x23D967BF,
       0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94,
       0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D
    };
    
  Size     = 0;
  Check = 0xffffffff;
    
  while(len--)
  {
    temp     = (Check ^ buff[Size]) & 0x000000FF;
    Check = ((Check >> 8) & 0x00FFFFFF) ^ crc32_table[temp];
    Size++;
  }
  
  Check = ~Check;
  
  return Check;
}

/// <Init>
byte FileCheckSum(dword  buff[],dword len)
{
  dword i;
  byte Sum;
  Sum    = 0x00;
  for(i = 0 ;i < len ;i++)
  {
    Sum += buff[i];
  }
  Sum = (byte)(0xFF - Sum);
  return Sum;
}

/// <Init>
void FileInit()
{
  dword i;
  dword j;
  dword k;
  char  FilePath1[512];//驱动程序
  dword FileHandle1;
  
  char  FilePath2[512];//APP程序
  dword FileHandle2;
    
  char  cbuf[512];//驱动程序
  long  copiedBytes;
  
  char  Buff[256];
  dword Data[256];
  
  
  dword FileRow;        //文件的行数
  
  byte  TempLen;
  dword CurrentrowAdressLen;
  int   status;
  dword CurrentrowStartaddress;
  dword byte_addr;
  
  
  FileRow                = 0;
  CurrentrowAdressLen    = 0;
  CurrentrowStartaddress = 0;
  
  testWaitForEnvVar(Flash_set,0);
  
  
  for(i = 0; i < 0x04000;i++)
  {
    g_Data.buffDriver[i] = 0xFF;
  }
  
  
  //首先解析驱动程序
  getValue(FilePath_Driver,FilePath1);
  FileHandle1 = openFileRead(FilePath1,0);  //打开文件进行读取（0：ASCII ,1：binary）
  
  if(FileHandle1 != 0)
  {
    while(fileGetString(Buff,elCount(Buff),FileHandle1) != 0)
    {
      if((Buff[0] == 'S') && ((Buff[1] == '1') ||(Buff[1] == '2') ||(Buff[1] == '3')))
      {
        FileRow++;
        TempLen = (byte)((HexToChar(Buff[2]) << 4) + HexToChar(Buff[3]) + 1);  //该行的总长度
        CurrentrowAdressLen = HexToChar(Buff[1]) + 1;
        for(i = 0;i < TempLen ;i++)
        {
          Data[i] = (byte)((HexToChar(Buff[(i + 1)*2]) << 4) + HexToChar(Buff[(i + 1)*2 + 1]));
          
          for(i = 0;i < TempLen ;i++)
          {
            Data[i] = (byte)((HexToChar(Buff[(i + 1)*2]) << 4) + HexToChar(Buff[(i + 1)*2 + 1])); //以字节形式存放
            
            if(HexToChar(Buff[1]) + 1 == i)
            {
              if(HexToChar(Buff[1]) == 1)
              {
                if(((Data[1] << 8) + Data[2] ) < DriverStartAdress)
                {
                  status = 1;
                  break;
                }
              }
              if(HexToChar(Buff[1]) == 2)
              {
                if(((Data[1] << 16) + (Data[2] << 8) + Data[3]) < DriverStartAdress)
                {
                  status = 1;
                  break;
                }
              }
              if(HexToChar(Buff[1]) == 3)
              {
                if(((Data[1] << 24) + (Data[2] << 16) + (Data[3] << 8) + Data[4]) < DriverStartAdress)
                {
                  status = 1;
                  break;
                }
              }
            }
            
            status = 0;
          }
        }
        if(status == 1)
        {
          continue;
        }
        
        if(Data[TempLen - 1] == FileCheckSum(Data,TempLen -1))
        {
          CurrentrowStartaddress = 0;
          
          for(i = 0;i < CurrentrowAdressLen;i++)//数据的地址
          {
            CurrentrowStartaddress += Data[i+1] << (8 * (CurrentrowAdressLen - i - 1));
          }
          for(i = 0;i < (TempLen - 2 - CurrentrowAdressLen);i++)
          {
            byte_addr = CurrentrowStartaddress + i;
            g_Data.buffDriver[byte_addr - DriverStartAdress] = Data[i + CurrentrowAdressLen + 1]; //前面八个字节用于存放地址跟长度
          }
        }
        else
        {
          testStepFail("fail","%d line checksum error!",FileRow);
        }
      }
    }
  }
  fileClose(FileHandle1);

  
  //解析APP报文
  FileRow                = 0;
  CurrentrowAdressLen    = 0;
  CurrentrowStartaddress = 0;
  
  for(i = 0 ; i < 0x00180000;i++)
  {
     g_Data.buff[i] = 0xFF;
  }
  
  getValue(FilePath,FilePath2);
  FileHandle2 = openFileRead(FilePath2,0);  //打开文件进行读取（0：ASCII ,1：binary）
  
  if(FileHandle2 != 0)
  {
    while(fileGetString(Buff,elCount(Buff),FileHandle2) != 0)
    {
      if((Buff[0] == 'S') && ((Buff[1] == '1') ||(Buff[1] == '2') ||(Buff[1] == '3')))
      {
        FileRow++;
        TempLen = (byte)((HexToChar(Buff[2]) << 4) + HexToChar(Buff[3]) + 1);  //该行的总长度
        CurrentrowAdressLen = HexToChar(Buff[1]) + 1;
        for(i = 0;i < TempLen ;i++)
        {
          Data[i] = (byte)((HexToChar(Buff[(i + 1)*2]) << 4) + HexToChar(Buff[(i + 1)*2 + 1])); //以字节形式存放
          
          if(HexToChar(Buff[1]) + 1 == i)
          {
            if(HexToChar(Buff[1]) == 1)
            {
//              if(((Data[1] << 24) + (Data[2] << 16) + (Data[3] << 8) + Data[4]) < 0x0C0000)
//              {
//                status = 1;
//                break;
//              }
            }
            if(HexToChar(Buff[1]) == 2)
            {
              if(((Data[1] << 16) + (Data[2] << 8) + Data[3]) < AppStartAdress)
              {
                status = 1;
                break;
              }
            }
            if(HexToChar(Buff[1]) == 3)
            {
              if(((Data[1] << 24) + (Data[2] << 16) + (Data[3] << 8) + Data[4]) < AppStartAdress)
              {
                status = 1;
                break;
              }
            }
          }
          status = 0;
        }
        if(status == 1)
        {
          continue;
        }
        if(Data[TempLen - 1] == FileCheckSum(Data,TempLen -1))
        {
          CurrentrowStartaddress = 0;
          for(i = 0;i < CurrentrowAdressLen ;i++)
          {
            CurrentrowStartaddress += Data[i+1] << (8*(CurrentrowAdressLen -1-i));
          }
          for(i = 0;i < TempLen -(CurrentrowAdressLen + 2);i++) //数据长度
          {
            byte_addr = CurrentrowStartaddress + i;
            g_Data.buff[byte_addr - AppStartAdress] = Data[i + CurrentrowAdressLen + 1];
          }
        }
        else
        {
          testStepFail("fail","%d line checksum error!",FileRow);
        }
      }
    }
  }
  fileClose(FileHandle2);
}


/// <Server>
server_10(byte response,dword id,byte Subfunction)
{
  dword length;  //该命令长度
  length            = 0;
  
  Tx_Data[length++] = 0x10;
  Tx_Data[length++] = Subfunction;
  
  TxMsgSrever(response,id,length,Tx_Data);
  
  
  
  
  if(ResetFlag == 1)
  {
    testWaitForTimeout(2000);
  }
  ResetFlag = 0;
}


/// <Server>
server_31(byte response,dword id,byte Subfunction,dword RID,dword data,dword flag)
{
  int i;
  dword length;
  length =0 ;
  
    Tx_Data[length++] = 0x31;
    Tx_Data[length++] = Subfunction;
    if(flag == 0) //擦除内存
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);      
      Tx_Data[length++] = 0x44;
      Tx_Data[length++] = (byte)((AppStartAdress >> 24) & 0xFF);//擦除地址
      Tx_Data[length++] = (byte)((AppStartAdress >> 16) & 0xFF);
      Tx_Data[length++] = (byte)((AppStartAdress >> 8)  & 0xFF);
      Tx_Data[length++] = (byte)( AppStartAdress        & 0xFF);
//      Tx_Data[length++] = 0x00;//错误擦除地址
//      Tx_Data[length++] = 0x24;//错误擦除地址
//      Tx_Data[length++] = 0x00;//错误擦除地址
//      Tx_Data[length++] = 0x01;//错误擦除地址
      Tx_Data[length++] = (byte)((AppLength >> 24) & 0xFF);//擦除长度
      Tx_Data[length++] = (byte)((AppLength >> 16) & 0xFF);
      Tx_Data[length++] = (byte)((AppLength >> 8)  & 0xFF);
      Tx_Data[length++] = (byte)( AppLength        & 0xFF);
    }
    if(flag == 1) //校验
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);
      Tx_Data[length++] = (byte)((data >> 24) & 0xFF);
      Tx_Data[length++] = (byte)((data >> 16) & 0xFF);
      Tx_Data[length++] = (byte)((data >>  8) & 0xFF);
      Tx_Data[length++] = (byte)( data        & 0xFF);      
    }
    if(flag == 2) //只发DID
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);
    }
    if(flag == 3) //检查文件合法性
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);
      
      for(i = 0;i< 10;i++)
      {
        Tx_Data[length++] = FileValid[i];
      }
    }
    if(flag == 4)//检查版本
    {
      Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
      Tx_Data[length++] = (byte)( RID         & 0xFF);
      
      for(i = 0;i < 1322;i++)
      {
        Tx_Data[length++] = VerCheck[i];
      }
    }
    if(flag==5)
    {
        Tx_Data[length++] = (byte)((RID >> 8)   & 0xFF);
        Tx_Data[length++] = (byte)( RID         & 0xFF);      
        Tx_Data[length++] = 0x44;

            Tx_Data[length++] = 0xFF;//错误擦除地址
            Tx_Data[length++] = 0xFF;//错误擦除地址
            Tx_Data[length++] = 0xFF;//错误擦除地址
            Tx_Data[length++] = 0xFF;//错误擦除地址
      Tx_Data[length++] = (byte)((AppLength >> 24) & 0xFF);//擦除长度
      Tx_Data[length++] = (byte)((AppLength >> 16) & 0xFF);
      Tx_Data[length++] = (byte)((AppLength >> 8)  & 0xFF);
      Tx_Data[length++] = (byte)( AppLength        & 0xFF);
    }
  TxMsgSrever(response,id,length,Tx_Data);
    
  
  if(_Sid31CheckFlag == 0)
  {
    if(g_Rx.byte(5) != 0x04)  //肯定响应参数为0x00时，pass
    {
      testStepFail("fail","Routine Completed unsuccessfully");
    }
  }
}
