/// <Server>
void server_34(byte response,dword id,dword DataStartAddress,dword DataLen)
{
  dword length;
  length      = 0;
  
  Tx_Data[length++] = 0x34;
  Tx_Data[length++] = 0x00;
  Tx_Data[length++] = 0x44;
  Tx_Data[length++] = (byte)((DataStartAddress >> 24) & 0xFF);
  Tx_Data[length++] = (byte)((DataStartAddress >> 16) & 0xFF);
  Tx_Data[length++] = (byte)((DataStartAddress >>  8) & 0xFF);
  Tx_Data[length++] = (byte)((DataStartAddress)       & 0xFF);
  Tx_Data[length++] = (byte)((DataLen          >> 24) & 0xFF);
  Tx_Data[length++] = (byte)((DataLen          >> 16) & 0xFF);
  Tx_Data[length++] = (byte)((DataLen          >>  8) & 0xFF);
  Tx_Data[length++] = (byte)((DataLen)                & 0xFF);
  
  TxMsgSrever(response,id,length,Tx_Data);
  
  block_length = (g_Rx.byte(3) <<8) + g_Rx.byte(4);//获取传输的块数据长度
    //block_length = 514;
}


//allDataLen:此次需要刷的总长度，blockLen：每一块能刷的长度，buffData[]：要刷的数据，extraData:0正常下载，其他不正常下载
/// <Server>
void server_36(byte response,dword id,dword allDataLen,dword blockLen,long buffData[],dword extraData)
{
  dword i,k,j;
  dword length;
  dword blockNum;
  dword lastBlockLen;
  
  dword DataBlockLen[4096];//每个块的有效长度（不含头部的长度）
  dword BlockData[4096][4096];//存储分块后的数据
  dword blockIndex;//当前处理的块号
  dword Tx_Data1[13]={0x36,0x01,0x4d,0x53,0x54,0x52,0x03,0x00,0x00,0x00,0x37,0x00,0x00};
  blockNum = 0;
  lastBlockLen = 0;
  length = 0;
  j = 0;
  
  if(allDataLen == FileLen)                             //进行APP下载，判断是否为完整文件下载
  {
    download_progress_flag = 1;                         //设置下载进度标志
  }
  
  blockNum = allDataLen/(blockLen - 2);                 //计算要传输的块数量=app长度/雷达返回的blocksize-2

  if((allDataLen % (blockLen - 2)) != 0){               //处理剩余数据
    lastBlockLen = allDataLen%(blockLen - 2) + 2;       //最后一块长度，剩余数据加上36与块序列   
    blockNum++;
  }

  //将数据存储起来  
  for(i = 1;i <= blockNum;i++)
  {
    //计算每一块数据长度
    if(i<blockNum) {
      DataBlockLen[i] = blockLen - 2;  //正常块数据长度

    } else {
      DataBlockLen[i] = (lastBlockLen != 0) ? (lastBlockLen - 2) : (blockLen - 2);
    }
    
    //填充块数据，对每一块数据进行赋值
    for(k = 0;k < DataBlockLen[i];k++) {
      BlockData[i][k] = buffData[(j++)];
    }
  }

  //传输数据  
  if(extraData == 0){                                   //正常下载模式
    for(blockIndex = 1; blockIndex <= blockNum;blockIndex++){
      length = 0;
      Tx_Data[length++] = 0x36;                         //服务id字节位        
      if(blockIndex==9) {
        Tx_Data[length++] = 0x9;                        //正常块号9,验证块号不连续时改成B
      }
      else{Tx_Data[length++] = blockIndex;}             //正常块号
//      Tx_Data[length++] = blockIndex;                 //正常块号
//      Tx_Data[length++] = 1;                          //块号固定1
        
      for(i = 0;i < DataBlockLen[blockIndex];i++){  
        Tx_Data[length++] =  BlockData[blockIndex][i];
      }
      if (allDataLen == FileLen) {                      //刷写app文件时
        
        if (blockIndex==1){                             //刷写第一个块时刷写2次
              //TxMsgSrever(response,id,length,Tx_Data);//多发一个index=1的block
              //TxMsgSrever1(0x0,id,13,Tx_Data1);       //连续帧丢失，1st Block发2帧后重发首帧
              testWaitForTimeout(2);
              TxMsgSrever(response,id,length,Tx_Data);
          }else{
              TxMsgSrever(response,id,length,Tx_Data);  //注释后数据块未完整传输
          }
      }
    else{     TxMsgSrever(response,id,length,Tx_Data);
    }        
    }
  }
  else{
    length = 0;
    blockIndex = 0x02;
    Tx_Data[length++] = 0x36;
    Tx_Data[length++] = blockIndex;
    for(i = 0;i < DataBlockLen[blockIndex];i++) {
      Tx_Data[length++] =  BlockData[blockIndex][i];
    }
    TxMsgSrever(response,id,length,Tx_Data);
  }

//  crc_8 = crc8CheckSum(buffData,allDataLen);
//  crc_16 = crc16CheckSum(buffData,allDataLen);  
  CheckSum = crc32CheckSum(buffData,allDataLen);
  
  if(allDataLen == FileLen){
     putvalue(Download,100);
     putvalue(FlashRate,100);
     download_progress_flag = 0;
  }
}
/// <Server>
void server_37(byte response,dword id,dword extraData){
  dword length;
  length = 0;
  
  if(extraData == 0x00)  {
    Tx_Data[length++] = 0x37;
  }
  else  {
    Tx_Data[length++] = 0x37;
    Tx_Data[length++] = extraData;
  }
  
  TxMsgSrever(response,id,length,Tx_Data);
  
  if(response == 0x77)  {
    if(g_Rx.byte(0) != 1)    {
      testStepFail("fail","37 server length error!");
    }
  }  
}

/// <Server>
void server_11(byte response,dword id,byte subfunction)
{
  dword length;
  length = 0;
  
  Tx_Data[length++] = 0x11;
  Tx_Data[length++] = subfunction;
  
  TxMsgSrever(response,id,length,Tx_Data);
  testWaitForTimeout(6000);
}
/// <Server>
void server_14(byte response,dword id,dword data)
{
  dword length;
  length = 0;
  
  Tx_Data[length++] = 0x14;
  Tx_Data[length++] = (data >> 16) & 0xFF;
  Tx_Data[length++] = (data >>  8) & 0xFF;
  Tx_Data[length++] =  data        & 0xFF;
  TxMsgSrever(response,id,length,Tx_Data);
}
testcase Download()
{
  float time;
  float interval;
  long Curtime[8];
  message 0x772 sendone;  //arc2.36 uds 0x771,arc2.31 use 0x772
  int i;
  
  time     = 0;
  interval = 0;
  setLogFileName("Logging", ".\\Logging\\Start_Stop_Logging{LocalTime}.blf");//设置日志文件的名称：相对路径+文件名（添加当前时间）
  startLogging("Logging",1000);//开始录制log（提前1秒开始记录）
    
  time = timeNow()/100000.0;
  
    
  ResetFlag = 1;
  putValueToControl("Flash","CAPL Output View","Enter Default session-进入默认会话");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_10(0x50,gFunId,0x01);
  
  if(getValue(FTOrAPP) == 1)
  {
    putValueToControl("Flash","CAPL Output View","Read DID-ECU产品型号");
    putValueToControl("Flash","CAPL Output View",1,1);  
    curDidlength = 16;
    server_22(0x62,gPhyId,0xF197);
    
    putValueToControl("Flash","CAPL Output View","Read DID-ECU硬件版本号");
    putValueToControl("Flash","CAPL Output View",1,1);  
    curDidlength = 10;
    server_22(0x62,gPhyId,0xF150);
    
    putValueToControl("Flash","CAPL Output View","Read DID-ECU软件版本号");
    putValueToControl("Flash","CAPL Output View",1,1);  
    curDidlength = 10;
    server_22(0x62,gPhyId,0xF189);
    for(i = 0;i < 10;i++) {
      FileValid[i] = g_Did.readDID[i];
    }
    
    curDidlength = 0;  
  }
      
  putValueToControl("Flash","CAPL Output View","Enter Extended session-进入扩展会话");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_10(0x50,gFunId,0x03);
  
  if(getValue(FTOrAPP) == 1)  {
    putValueToControl("Flash","CAPL Output View","Control DTC Off-关闭DTC设置");
    putValueToControl("Flash","CAPL Output View",1,1);  
    server_85(0xC5,gFunId,0x02);
    
    putValueToControl("Flash","CAPL Output View","Communication Control-关闭通讯");
    putValueToControl("Flash","CAPL Output View",1,1);  
    server_28(0x68,gFunId,0x03,0x01);
  }
  
  putValueToControl("Flash","CAPL Output View","Enter Programming session-进入编程会话");
  putValueToControl("Flash","CAPL Output View",1,1);  
  
  ResetFlag = 1;
  server_10(0x50,gPhyId,0x02);
  if(getValue(BOOT_Proto) == 0){
    g_Tx.BRS = 0;
    g_Tx.FDF = 0;
    g_server3E.FDF = 0;
    g_server3E.BRS = 0;
  }
  else  {
    g_Tx.BRS = 1;
    g_Tx.FDF = 1;
    g_server3E.FDF = 1;
    g_server3E.BRS = 1;
  }
  
  gPhyId = getValue(PhyID);
  gFunId = 0x7DF;
  
  sendone.DataLength=8;
  sendone.BRS = 0;
  sendone.FDF = 0;
  sendone.byte(0) = 0x3;
  sendone.byte(1) = 0xFB;
  sendone.byte(2) = 0xA5;
  sendone.byte(3) = 0x00;
  testWaitForTimeout(10);
    if(getValue(sendOneFlag) == 1)
    {
        output(sendone);//升级不带验签文件时使用,完整性校验时去掉
    }
  
  testWaitForTimeout(30);

  putValueToControl("Flash","CAPL Output View","Process Security Access-解密");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_27(0x67,gPhyId,0x11,0);
  
//  testWaitForTimeout(1000);
  server_27(0x67,gPhyId,0x12,0);//正常测试

  
  putValueToControl("FlashChery","CAPL Output View","check Routine-检查文件合法性");
  putValueToControl("FlashChery","CAPL Output View",1,1);
  ReadVerSion(); //此函数用于读取VerCheck[]
  server_31(0x71,gPhyId,0x01,0x6000,0,4);//最后3：检查文件合法性,验签asc文件
  
  
  putValueToControl("FlashChery","CAPL Output View","check Routine-检查版本");
  putValueToControl("FlashChery","CAPL Output View",1,1);  
  server_31(0x71,gPhyId,0x01,0x6001,0,2);//最后4：检查版本
    
  putValueToControl("Flash","CAPL Output View","Write ProgrammingDate-写序列号");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_2E(0x6E,gPhyId,0xF198,Serial,16);
  
  putValueToControl("Flash","CAPL Output View","Write ProgrammingDate-编程日期");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_2E(0x6E,gPhyId,0xF199,fingerdata,4);
  
  putValueToControl("Flash","CAPL Output View","Request Download-请求驱动下载");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_34(0x74,gPhyId,DriverStartAdress,DriverLength);
//  stop();
  ////  
  putValueToControl("Flash","CAPL Output View","Transfer Data-驱动下载");
  putValueToControl("Flash","CAPL Output View",1,1);  
    //g_Data.buffDriver[block_length] = 0xff;  //无效的驱动数据文件
  server_36(0x76,gPhyId,DriverLength,block_length,g_Data.buffDriver,0x00);
//  
  putValueToControl("Flash","CAPL Output View","Transfer Exit-驱动下载完成");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_37(0x77,gPhyId,0x00);
  
  putValueToControl("FlashChery","CAPL Output View","check Routine-驱动校验");
  putValueToControl("FlashChery","CAPL Output View",1,1);  
  server_31(0x71,gPhyId,0x01,0x0202,CheckSum,1);//最后1：校验
  //server_31(0x71,gPhyId,0x01,0x0202,0x01020304,1);//最后1：校验码错误

  putValueToControl("Flash","CAPL Output View","Routine Control – erase Memory-擦除内存");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_31(0x71,gPhyId,0x01,0xFF00,0,0);//最后0：擦除内存
  //server_31(0x71,gPhyId,0x01,0xFF00,0,5);//最后5：擦除内存地址无效测试
  
    
   
  putValueToControl("Flash","CAPL Output View","Request Download-请求软件下载");
  putValueToControl("Flash","CAPL Output View",1,1);  
  //server_34(0x74,gPhyId,0x000D0000,0x00180000);   //测试错误刷写地址，同时修改31服务中擦地址
  server_34(0x74,gPhyId,AppStartAdress,FileLen);//正常刷写内容地址
  
  putValueToControl("Flash","CAPL Output View","Transfer Data-软件下载");
  putValueToControl("Flash","CAPL Output View",1,1); 
    //g_Data.buff[block_length]=0xFF;   //篡改APP内容
  //server_36(0x76,gPhyId,0x00740000,block_length,g_Data.buff,0x00);
 server_36(0x76,gPhyId,FileLen,block_length,g_Data.buff,0x00);//正常
  //server_36(0x76,gPhyId,FileLen,block_length+2,g_Data.buff,0x00);//块长度大于反馈长度，NRC13修改block_length2049/2051
  //server_36(0x76,gPhyId,FileLen,514,g_Data.buff,0x00);//块长度大于反馈长度,验证n*256，可以刷写成功


  putValueToControl("Flash","CAPL Output View","Request Transfer Exit-软件下载完成");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_37(0x77,gPhyId,0x00);
  
  putValueToControl("Flash","CAPL Output View","check Routine-检查已下载数据");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_31(0x71,gPhyId,0x01,0x0203,0,2);//最后2：只发送RID
  
  putValueToControl("flash","CAPL Output View","Check Programming Dependencies");
  putValueToControl("flash","CAPL Output View",1,1);  
  server_31(0x71,gPhyId,0x01,0xFF01,0,2);
  
  putValueToControl("Flash","CAPL Output View","ECU Reset – hard reset-硬件复位");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_11(0x51,gPhyId,0x01);
  
  putValueToControl("Flash","CAPL Output View","Enter Extended session-进入扩展会话");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_10(0x50,gFunId,0x03);
  
  putValueToControl("Flash","CAPL Output View","Communication Control-打开通讯");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_28(0x68,gFunId,0x00,0x01);
  
  putValueToControl("Flash","CAPL Output View","Control DTC Off-打开DTC设置");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_85(0xC5,gFunId,0x01);
  
  putValueToControl("Flash","CAPL Output View","Clear DTC-清除DTC");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_14(0x54,gFunId,0xFFFFFF);
    
  putValueToControl("Flash","CAPL Output View","Enter Default session-进入默认会话");
  putValueToControl("Flash","CAPL Output View",1,1);  
  server_10(0x50,gFunId,0x01);

  interval = (timeNow()/100000.0) - time;
  putValue(FlashTime,interval);
  
    stopLogging("Logging");//停止录制log（滞后1秒停止记录）
}

