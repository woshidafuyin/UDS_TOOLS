variables
{
  dword gPhyId = 0x772;
  dword gFunId = 0x7DF;
  dword gResId = 0x77a;
  
  message 0x000 g_Tx = {dlc = 8};
  message 0x000 g_Rx = {dlc = 8};
  
  message 0x000 g_server3E = {dlc = 0x08};
  msTimer test_online;
  
  const dword S3server = 4000;
  dword   routine = 0;
  
  dword   block_length;
  
  dword   CheckSum;
  
  dword   Tx_Data[4096];  //存储除服务以外的数据，包括子服务和参数
  dword   Rx_Data[100];
  byte    seed_L1[4]     = {0,0,0,0};
  byte    seed_L2[4]     = {0,0,0,0};
  int     download_progress_flag;
  dword   transform_data;
  int     ResetFlag;
  dword   fingerdata[4];
  dword   curDidlength    = 0;//当前DID长度
  dword   readByteNum;
  byte    CurDidData[2]   = {0,0};//当前读取的DID
  dword   FileLen;//app长度
  
  enum Msg_State
  {
    MsgTrue  = 1,
    MsgFalse = 0
  };
    
  struct Data_Type
  {
    dword State;
    long  buff[0x00180000];
    long  buffDriver[0x4000];//用于存储驱动程序的地址+长度＋数据
  }g_Data;
  
  struct DIDData
  {
    byte writeDID[40];//存放需要写入的DID数据
    byte readDID[40];
      
    byte errorlength[17];
  }g_Did;  
  
  byte crc_8;
  word  crc_16;   

  byte VerCheck[1322];//存放版本信息（hash+rs2048）
  
  byte Sha_256[32];
  byte Signature[1024];
  byte FileValid[10]; //存文件版本号
  byte RSA2048[256];  
  
  dword Serial[16]; //写入序列号信息
  
  int  _Sid31CheckFlag;//判断31服务中是否为正常情况，0：正常，1:不正常
  
  dword  TransFrameNum;//判断发送的帧数，发送完实际的连续帧在进行响应判断
  dword  CurTransFrameNum;//当前发送完的连续帧  
  
  byte   TransFCFFFrame;  
  
  dword  DriverLength;
  dword  DriverStartAdress;
  dword  AppLength;
  dword  AppStartAdress;
  
  dword  _P2Server;//p2*参数时间   
}

on timer test_online
{
  server_3e(0x00,gFunId,0x80,0x02);
  //server_3e(0x00,gFunId,0x00,0x02);
  setTimer(test_online,S3server/2);
}

on message *
{
  if(this.id == gResId)
  {
    g_Rx.id      = this.id;
    g_Rx.byte(0) = this.byte(0); 
    g_Rx.byte(1) = this.byte(1);
    g_Rx.byte(2) = this.byte(2); 
    g_Rx.byte(3) = this.byte(3);
    g_Rx.byte(4) = this.byte(4); 
    g_Rx.byte(5) = this.byte(5);
    g_Rx.byte(6) = this.byte(6); 
    g_Rx.byte(7) = this.byte(7);
    PrintMsgReceive(g_Rx);
    
    if(g_Rx.byte(1) == 0x67 && g_Rx.byte(2) == 0x01)
    {
      seed_L1[0] = g_Rx.byte(3);
      seed_L1[1] = g_Rx.byte(4);
      seed_L1[2] = g_Rx.byte(5);
      seed_L1[3] = g_Rx.byte(6);
    }
    
    if(g_Rx.byte(1) == 0x67 && g_Rx.byte(2) == 0x11)//boot下
    {
      seed_L2[0] = g_Rx.byte(3);
      seed_L2[1] = g_Rx.byte(4);
      seed_L2[2] = g_Rx.byte(5);
      seed_L2[3] = g_Rx.byte(6);
    }
    
    if(curDidlength != 0)
    {
      if(g_Rx.byte(1) == 0x62 || g_Rx.byte(2) == 0x62 || ((g_Rx.byte(0) >= 0x20) && (g_Rx.byte(0) <= 0x2F)))
      {
        JudgeReadData();
      }
    }
  }
  if(this.id == gPhyId || this.id == gFunId)
  {
    if(this.id == gPhyId && (this.byte(0) >=0x20 && this.byte(0) <0x30)) //发送完完整的连续帧
    {
      CurTransFrameNum++;
      if(g_Rx.byte(1) != 0x00)
      {
        if(CurTransFrameNum % g_Rx.byte(1) == 0)
        {
          putValue(CFFrameNum,1);
        }
      }
      
      if(CurTransFrameNum == TransFrameNum)
      {
        putValue(CFFrameNum,1);
      }
    }  
    else //单帧或首帧
    {
      TransFCFFFrame++;
      if(TransFCFFFrame == 1)
      {
        putValue(OneFrameTranse,1);
      }
    }
    
  }
}

//该函数主要用于读取信息（面板上VerCheck）
void ReadVerSion(){
  dword i;
  dword j;
  dword k;
  char  FilePath3[200];
  dword FileHandle3;
  char  Buff[256];
  
  char  temp[20];
  
  temp[0] = '0';
  temp[1] = 'x';
  
  j = 0;
  
  //首先解析驱动程序
  getValue(FilePath_data,FilePath3);
  FileHandle3 = openFileRead(FilePath3,0);  //打开文件进行读取（0：ASCII ,1：binary）
  
  if(FileHandle3 != 0) //用于读取值信息，信息存放在VerCheck[]
  {
    while(fileGetString(Buff,elCount(Buff),FileHandle3) != 0)    {
      for(i = 0;i < (strlen(Buff)+1)/3;i++)      {
        temp[2] = Buff[i*3];
        temp[3] = Buff[i*3+1];
        
        VerCheck[j++] = atol(temp);
      }
    }
  }   
  fileClose(FileHandle3);    
}
/// <Judge>
void JudgeReadData()
{
  int i;
  int j;
  
  if(g_Rx.byte(0) <= 0x07 && CurDidData[0] == g_Rx.byte(2) && CurDidData[1] == g_Rx.byte(3))
  {
    readByteNum = g_Rx.byte(0) - 3;
    
    if(readByteNum == curDidlength)
    {
      for(i = 0;i < readByteNum;i++)
      {
        g_Did.readDID[i] = g_Rx.byte(4+i);
      }
    }
    else
    {
      readByteNum = g_Rx.byte(0) - 3;
     testStepFail("fail","DID:%x%x has %d byte",g_Rx.byte(2),g_Rx.byte(3),g_Rx.byte(0)-3);
      
    }
    
  }
  else
  {
    if((g_Rx.byte(0) >= 0x10) && (g_Rx.byte(0) < 0x20) && CurDidData[0] == g_Rx.byte(3) && CurDidData[1] == g_Rx.byte(4))
    {
      readByteNum =  g_Rx.byte(1) - 3;
      j = 0;
      if(readByteNum == curDidlength)
      {
        for(i = 0;i < 3;i++)
        {
          g_Did.readDID[j++] = g_Rx.byte(5+i);
        }
      }
      else
      {
        readByteNum = g_Rx.byte(1) - 3;
        testStepFail("fail","DID:%x%x has %d byte",g_Rx.byte(2),g_Rx.byte(3),g_Rx.byte(1)-3);
      }
    }
    if((g_Rx.byte(0) > 0x20) && (g_Rx.byte(0) < 0x30) )
    {
      for(i = 0;i < 7;i++)
      {
        if(j < readByteNum)
        {
          g_Did.readDID[j++] = g_Rx.byte(i+1);
        }
      }
    }
  }
}

void PrintMsgOutput(message* msg)
{
  //if(msg.byte(0)==0x18 && msg.byte(1)==0x02 && msg.byte(2)==0x36)

if((msg.byte(0)&0xF0)==0x20){write("xx");}
else{
  testStep("Tx","[%x] [%.2x %.2x %.2x %.2x %.2x %.2x %.2x %.2x]",
  msg.id,msg.byte(0),msg.byte(1),msg.byte(2),msg.byte(3),msg.byte(4),msg.byte(5),msg.byte(6),msg.byte(7)); 
}
}

void PrintMsgReceive(message* msg)
{
   // if(msg.byte(0)==0x02 && msg.byte(1)==0x76){}
   if(msg.byte(0)==0x30 && msg.byte(1)==0x00)
{}
else{
  testStep("Rx","[%x] [%.2x %.2x %.2x %.2x %.2x %.2x %.2x %.2x]",
  msg.id,msg.byte(0),msg.byte(1),msg.byte(2),msg.byte(3),msg.byte(4),msg.byte(5),msg.byte(6),msg.byte(7)); 
}
}

byte CharToHex(char s[],int index)
{
  long WriteData;
  char src[5] = "0x";
  
  src[2] = s[index*3]; 
  src[3] = s[index*3 + 1];
  
  strtol(src,WriteData);
  
  return WriteData;
}

void output_FC()
{
  g_Tx.id      = gPhyId;
  g_Tx.byte(0) = 0x30;
  g_Tx.byte(1) = 0x00;
  g_Tx.byte(2) = 0x00;
  g_Tx.byte(3) = 0x55;
  g_Tx.byte(4) = 0x55;
  g_Tx.byte(5) = 0x55;
  g_Tx.byte(6) = 0x55;
  g_Tx.byte(7) = 0x55;
  output(g_Tx);
  PrintMsgOutput(g_Tx);
}

nodeDropErrorHandling(long silent)
{
  long channel = 1;
  switch(silent)
  {
    case 0:{testStepPass("nodeDrop","nodeDropError");};break;
    case 1:{testStepPass("nodeDrop","nodeDropErrorRecovery");};break;
  }
  canSetChannelOutput(channel, silent);
}

void JudgeResponse(byte response,dword service)
{
  int flag_NRC78;
  if(response == 0)  //不期待接收到响应
  {
    if(0 == testWaitForMessage(gResId,50))
    {
      testStepPass("pass","111%x Service dosn't response anything",service);
    }
    else
    {
      if(g_Rx.byte(3) == 0x78 || g_Rx.byte(1) == 0x7e)
      {
        flag_NRC78 = 1;
        while(1)
        {
            if(1 == testWaitForMessage(gResId ,_P2Server))
            {
                if(g_Rx.byte(3) == 0x78)
                {
                  flag_NRC78 = 1;
                  testStep("wait","222%x Service returns response pending:[0x%x] ",service,g_Rx.byte(3));
                }
                else
                {
                  flag_NRC78 = 0;
                  if(g_Rx.byte(1) == 0x40+service )
                  {
                   // g_Data.State = MsgFalse;
                    testStepWarning("Warning","333%x Service returnsresponse:[0x%x],response nothing",service,g_Rx.byte(1));
                    break;
                  }
                  else if(g_Rx.byte(2) == 0x40+service)
                  {
                    testStepWarning("Warning","444%x Service returns response:[0x%x],response nothing",service,g_Rx.byte(2));
                    break;
                  }
                  else
                  {
                    testStepWarning("Warning","555%x Service returns negative response:[0x%x],response nothing",service,g_Rx.byte(3));
                    break;
                  }
                }
              }
            else
            {
              break;
            }
        }
        if(flag_NRC78 == 1)
        {
          testStepFail("fail","666%x Service returns negative response:[0x%x],response nothing",service,g_Rx.byte(3));
        }
      }
      
      else
      {
        g_Data.State = MsgFalse;
        testStepFail("fail1","777%.2x Service responsed anything,response nothing",service);
      }
    }
  }
  else  //期望接收到响应
  {
    if(response == service + 0x40)  //肯定响应
    {
      if(1 == testWaitForMessage(gResId,50))
      {
        
        if((g_Tx.byte(1) == 0x10) && (g_Tx.byte(2) == 0x02))
        {
          gResId = getValue(ResID);
        }
        
        if(g_Rx.byte(1) == response)  //单帧响应
        {
          testStepPass("pass","888%s service has postive response",service);
        }
        else if(g_Rx.byte(2) == response)   //多帧响应，需发送流控帧
        {
          testStepPass("pass","999%s service has postive response",service);
          output_FC();
          while(1)  //等待CF传输完毕
          {
            if(0 == testWaitForMessage(gResId,128))  //等待连续帧接收完毕，才执行其他步骤
            {
              testStepPass("pass","aaa%x service return successive frames",service);
              break;
            }
          }
        }
        else if(g_Rx.byte(2) == service && g_Rx.byte(3) != 0x78) //否定响应
        {
          g_Data.State = MsgFalse;
          testStepFail("fail","bbb%s service has negative response (%s),hope to receive response:[0x%x]",service ,g_Rx.byte(3),response);
        }
        else if(g_Rx.byte(3) == 0x78)
        {
          while(1)  //可能接收到多次NRC78,除接收到NRC78之外的数据，均可跳出该循环
          {
            if(1 == testWaitForMessage(gResId ,_P2Server))
            {
              if(g_Rx.byte(1) == response)
              {
                testStepPass("pass","ccc%s service has postive response",service);
                break;
              }
              else if(g_Rx.byte(2) == response)
              {
                testStepPass("pass","ddd%s service has postive response",service);
                output_FC();
                while(1)  //等待CF传输完毕
                {
                  if(0 == testWaitForMessage(gResId,128))  //等待连续帧接收完毕，才执行其他步骤
                  {
                    testStepPass("pass","fff%x service return successive frames",service);
                    break;
                  }
                }
              }
              else
              {
                if(g_Rx.byte(3) == 0x78)
                {
                  testStep("wait","gggx Service returns response pending:[0x%x] ",service,g_Rx.byte(3));
                  
                  if(routine == 1) //进行通讯中断
                  {
                    nodeDropErrorHandling(0);
                    testWaitForTimeout(500);
                    g_Data.state = MsgFalse;
                    nodeDropErrorHandling(1);
                    break;
                  }
                  
                }
                else
                {
                  g_Data.State = MsgFalse;
                  testStepFail("fail","hhh%x Service returns negative response:[0x%x],hope to receive response:[0x%x]",service,g_Rx.byte(3),response);
                  break;
                }
              }
            }
            else
            {
              g_Data.State = MsgFalse;
              testStepFail("fail","iii%x Service dosn't response anything after pending:[0x%x]",service,0x78);
              break;
            }
          }
        }
      }
      else
      {
        g_Data.State = MsgFalse;
        testStepFail("fail","%x has no response",service);
      }
    }
    else  //其他类型响应（NRC）
    {
      if(1 == testWaitForMessage(gResId,50))
      {
        if(g_Rx.byte(1) == 0x7F && g_Rx.byte(3) == 0x78)
        {
          while(1)
          {
            if(1 == testWaitForMessage(gResId ,_P2Server))
            {
              if(g_Rx.byte(1) == 0x7F && g_Rx.byte(3) == 0x78)
              {
                testStep("wait","%x Service returns response pending:[0x%x] ",service,g_Rx.byte(3));
              }
              else
              {
                if(g_Rx.byte(3) == response)
                {
                  g_Data.State = MsgFalse;
                  testStepPass("pass","%x Service returns negative response:[0x%x]",service ,g_Rx.byte(3));
                }
                else
                {
                  if(g_Rx.byte(1) == service + 0x40)
                  {
                    g_Data.State = MsgFalse;
                    testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x]",service ,g_Rx.byte(1),response);
                  }
                  if(g_Rx.byte(2) == service + 0x40)
                  {
                    g_Data.State = MsgFalse;
                    testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x]",service ,g_Rx.byte(2),response);
                  }
                  if(g_Rx.byte(1) == 0x7F)
                  {
                    g_Data.State = MsgFalse;
                    testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x]",service,g_Rx.byte(3),response);
                  }
                }
                break;
              }
            }
          }
        }
        else if(g_Rx.byte(1) == 0x7F && g_Rx.byte(3) != 0x78)
        {
          if(g_Rx.byte(3) == response)
          {
            g_Data.State = MsgFalse;
            testStepPass("pass","%x Service returns negative response:[0x%x]",service ,g_Rx.byte(3));
          }
          else
          {
            g_Data.State = MsgFalse;
            testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x]",service,g_Rx.byte(3),response);
          }
        }
        else                      //不知名服务
        {
          if(g_Rx.byte(2) == service + 0x40)
          {
            output_FC();
            while(1)  //等待CF传输完毕
              {
                if(0 == testWaitForMessage(gResId,128))  //等待连续帧接收完毕，才执行其他步骤
                {
                  break;
                }
              }
          }
          if(g_Rx.byte(1) == service + 0x40)
          {
            g_Data.State = MsgFalse;
            testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x]",service ,g_Rx.byte(1),response);
          }
          if(g_Rx.byte(2) == service + 0x40)
          {
            g_Data.State = MsgFalse;
            testStepFail("fail","%x Service returns response:[0x%x],hope to receive response:[0x%x]",service ,g_Rx.byte(2),response);
          }
        }
      }
      else
      {
        g_Data.State = MsgFalse;
        testStepFail("fail","%x has no response",service);
      }
    }
  }
  
}

void TxTPData(dword id,dword length,dword data[],dword serve)
{
  int cur_cf_number,cur_data_number;
  int sent_cf_n;
  int i,TempLen;
  int accepted_fc_n;
  
  
  g_Tx.id       = id;
  sent_cf_n     = 0;
  TempLen       = 0;
  accepted_fc_n = 0;
  
  cur_cf_number = length/0x07;
  cur_data_number = length - 0x06;
  
  TransFrameNum = cur_cf_number;
  CurTransFrameNum = 0;
  putValue(CFFrameNum,0);
  
  if(1 == testWaitForMessage(gResId,50))
  {
    g_Tx.byte(0) = 0x21;
    if(g_Rx.byte(0) == 0x30)
    {
      accepted_fc_n++;
      while(sent_cf_n < cur_cf_number)
      {
        for(i = 1; i <= 0x07; i++)
        {
          if(TempLen < cur_data_number)
          {
            g_Tx.byte(i) = data[TempLen];
            TempLen++;
            
            if(download_progress_flag == 1)
            {
              transform_data++;
            }
          }
          else
          {
            g_Tx.byte(i) = 0x55;
          }
        }
        if(g_Rx.byte(1) != 0x00) //此数不会发生改变
        {
          if(abs(sent_cf_n - (accepted_fc_n * g_Rx.byte(1))) == 0)
          {
            testWaitForEnvVar(CFFrameNum,1000);
            
            if(1 == testWaitForMessage(gResId,150))
            {
              if(g_Rx.byte(0) == 0x30)
              {
                accepted_fc_n++;
              }
            }
            else
            {
              testStepFail("fail","No CF was received!");
              break;
            }
            putValue(CFFrameNum,0);
          }
        }
        output(g_Tx);
        
        if(serve != 0x36)
        {
          PrintMsgOutput(g_Tx);
        }
        
        sent_cf_n++;
        
        if(g_Tx.byte(0) == 0x2F)
        {
          g_Tx.byte(0) = 0x1F;
        }
        g_Tx.byte(0)++;
      }
      if(download_progress_flag == 1)
      {
        putvalue(Download,(((float)(transform_data)) / FileLen)*100);
        putvalue(FlashRate,(((float)(transform_data)) / FileLen)*100);
      }
   }
    testWaitForEnvVar(CFFrameNum,1000);
  }
}

void TxMsgSrever(byte response,dword id,dword length,dword Data[])
{
  int i,j,tp_data_n;
  dword tp_Data[4096];
  tp_data_n = 0;
  g_Tx.id = id;    
  
  TransFCFFFrame = 0;
  //putValue(OneFrameTranse,0);  
  
  if((0x00 < length) && (length < 0x08))//单帧
  {
    g_Tx.byte(0) = length;
    for(i = 0 ; i < length ; i++)
    {
      g_Tx.byte(i+1) = Data[i];
    }
    for(i = length + 1 ; i < 0x08 ; i++)
    {
      g_Tx.byte(i) = 0x55;
    }
    output(g_Tx);
    testWaitForEnvVar(OneFrameTranse,2000);
    
    PrintMsgOutput(g_Tx);
  }
  else if((0x07 < length) && (length <= 0xfff))//首帧
  {
    g_Tx.byte(0) = 0x10 + ((length >> 8) & 0xFF);
    g_Tx.byte(1) = length & 0xFF;
    for(i = 0;i < 0x06;i++)
    {
     g_Tx.byte(i+2) = Data[i];
    }
    output(g_Tx);
    testWaitForEnvVar(OneFrameTranse,2000);
    
    PrintMsgOutput(g_Tx);
    for(i = 6 ;i < length ;i++)
    {
      tp_Data[tp_data_n] = Data[i];
      tp_data_n++;
    }    
    TxTPData(id,length,tp_Data,Data[0]);
  }
  
  JudgeResponse(response,Data[0]);  
  //testWaitForTimeout(200);//接受等待时间
}

