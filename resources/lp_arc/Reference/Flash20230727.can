      tp_data_n++;
    }    
    TxTPData(id,length,tp_Data,Data[0]);
  }
  
  JudgeResponse(response,Data[0]);  
  //testWaitForTimeout(200);//接受等待时间
}

void TxTPCANFDData(dword id,dword length,dword data[],dword serve)
{
  int cur_cf_number,cur_data_number;
  int sent_cf_n;
  int i,TempLen;
  int accepted_fc_n;

  g_Tx.id       = id;
  sent_cf_n     = 0;
  TempLen       = 0;
  accepted_fc_n = 0;

  cur_cf_number = length/63;
  cur_data_number = length - 62;

  TransFrameNum = cur_cf_number;
  CurTransFrameNum = 0;
  putValue(CFFrameNum,0);

  if(1 == testWaitForMessage(gResId,50))
  {
    g_Tx.byte(0) = 0x21;
    if(g_Rx.byte(0) == 0x30)
    {
      accepted_fc_n++;
      while(sent_cf_n < cur_cf_number)
      {
        if((cur_data_number - TempLen) > 63)
        {
          g_Tx.DataLength = 64;
          for(i = 1; i <= 63; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;

              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }

        else if((cur_data_number - TempLen) <8)
        {
          g_Tx.DataLength = 8;
          for(i = 1; i < 8; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;

              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }
        else if((cur_data_number - TempLen) <12)
        {
          g_Tx.DataLength = 12;
          for(i = 1; i < 12; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;
           
              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }
        else if((cur_data_number - TempLen) <16)
        {
         g_Tx.DataLength = 16;
          for(i = 1; i < 16; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;
             
              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }
        else if((cur_data_number - TempLen) <20)
        {
          g_Tx.DataLength = 20;
          for(i = 1; i < 20; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;
              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }
        else if((cur_data_number - TempLen) <24)
       {
         g_Tx.DataLength = 24;
          for(i = 1; i < 24; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;

              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }

            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }

        else if((cur_data_number - TempLen) <32)
        {
          g_Tx.DataLength = 32;
          for(i = 1; i < 32; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;

              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }

        else if((cur_data_number - TempLen) <48)
        {
          g_Tx.DataLength = 48;
          for(i = 1; i < 48; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;
             
              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }
        else if((cur_data_number - TempLen) <64)
        {
          g_Tx.DataLength = 64;
          for(i = 1; i < 64; i++)
          {
            if(TempLen < cur_data_number)
            {
              g_Tx.byte(i) = data[TempLen];
              TempLen++;
              
              if(download_progress_flag == 1)
              {
                transform_data++;
              }
            }
            else
            {
              g_Tx.byte(i) = 0x55;
            }
          }
        }

        if(g_Rx.byte(1) != 0x00) //此数不会发生改变
        {
          if(abs(sent_cf_n - (accepted_fc_n * g_Rx.byte(1))) == 0)
          {
            testWaitForEnvVar(CFFrameNum,1000);

            if(1 == testWaitForMessage(gResId,150))
            {
              if(g_Rx.byte(0) == 0x30)
              {
                accepted_fc_n++;
              }
            }
            else
            {
              testStepFail("fail","No CF was received!");
              break;
            }
            putValue(CFFrameNum,0);
          }
        }
        output(g_Tx);
        
        if(serve != 0x36)
        {
          PrintMsgOutput(g_Tx);
        }

        sent_cf_n++;

        if(g_Tx.byte(0) == 0x2F)
        {
          g_Tx.byte(0) = 0x1F;
        }
        g_Tx.byte(0)++;
      }

      if(download_progress_flag == 1)
      {
        putvalue(Download,(((float)(transform_data)) / FileLen)*100);
        putvalue(FlashRate,(((float)(transform_data)) / FileLen)*100);
      }
   }
    testWaitForEnvVar(CFFrameNum,1000);
  }
}



void TxMsgCANFDSrever(byte response,dword id,dword length,dword Data[])
{
  int i,j,tp_data_n;
  dword tp_Data[4096];
  tp_data_n = 0;
  g_Tx.id = id;    
 
  TransFCFFFrame = 0;
  //putValue(OneFrameTranse,0);  

  if((0x00 < length) && (length < 0x40-1))//单帧
  {
    if(length<8)
    {
      g_Tx.byte(0) = length;
      g_Tx.DataLength = 8;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+1) = Data[i];
      }

      for(i = length + 1 ; i < 0x08 ; i++)
      {
        g_Tx.byte(i) = 0x55;
      }
    }

    else if(length<=10)
    {
      g_Tx.DataLength = 12;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+2) = Data[i];
      }
      for(i = length + 2 ; i < 12 ; i++)
      { g_Tx.byte(i) = 0x55;
      }
    }
    else if(length<14)
    {
      g_Tx.DataLength = 16;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+2) = Data[i];
      }
      for(i = length + 2 ; i < 16 ; i++)
      {
        g_Tx.byte(i) = 0x55;
      }
    }

    else if(length<=18)
    {
      g_Tx.DataLength = 20;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+2) = Data[i];
      }

      for(i = length + 2 ; i < 20 ; i++)
      {
        g_Tx.byte(i) = 0x55;
      }
    }

    else if(length<=22)
    {
      g_Tx.DataLength = 24;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+2) = Data[i];
      }

      for(i = length + 2 ; i < 24 ; i++)
      {        g_Tx.byte(i) = 0x55;

      }
    }

    else if(length<=30)
    {
      g_Tx.DataLength = 32;
      for(i = 0 ; i < length ; i++)
      {        g_Tx.byte(i+2) = Data[i];

      }
      for(i = length + 2 ; i < 32 ; i++)
      {
        g_Tx.byte(i) = 0x55;
      }
    }
    else if(length<=46)
    {
      g_Tx.DataLength = 48;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+2) = Data[i];
      }

      for(i = length + 2 ; i < 48 ; i++)
      {
        g_Tx.byte(i) = 0x55;
      }
    }

    else if(length<=62)
    {
      g_Tx.DataLength = 64;
      for(i = 0 ; i < length ; i++)
      {
        g_Tx.byte(i+2) = Data[i];
      }
      for(i = length + 2 ; i < 64 ; i++)
      {
        g_Tx.byte(i) = 0x55;
      }
    }
    if(length>=8)
    {
        g_Tx.byte(0) = 0;
        g_Tx.byte(1) = length;
    }

    output(g_Tx);
    testWaitForEnvVar(OneFrameTranse,2000);
    
    PrintMsgOutput(g_Tx);
  }
  else if((64 < length) && (length <= 0xfff))//首帧
  {
    g_Tx.byte(0) = 0x10 + ((length >> 8) & 0xFF);
    g_Tx.byte(1) = length & 0xFF;
    for(i = 0;i < 62;i++)
    {
     g_Tx.byte(i+2) = Data[i];
    }

    g_Tx.DataLength = 64;
    output(g_Tx);
    testWaitForEnvVar(OneFrameTranse,2000);

    PrintMsgOutput(g_Tx);
    for(i = 62 ;i < length ;i++)
    {
      tp_Data[tp_data_n] = Data[i];
      tp_data_n++;
    }    
    TxTPData(id,length,tp_Data,Data[0]);
  }
  JudgeResponse(response,Data[0]);
  //testWaitForTimeout(200);//接受等待时间
}

/// <Server>
server_3e(byte response,dword id,byte Subfunction,byte length)
{
  int i;
  g_server3E.id = id;
  g_server3E.byte(0) = length;
  g_server3E.byte(1) = 0x3E;
  for(i = 2 ;i < 0x08 ;i++)
  {
    g_server3E.byte(i) = 0x00;
  }
  
  if(length == 0x02)
  {
    g_server3E.byte(2) = Subfunction;
  }
  if(length > 0x02)
  {
    g_server3E.byte(2) = Subfunction;
    for(i = 3;i <= length;i++)
    {
      g_server3E.byte(i) = 0x01;
    }
  }
  output(g_server3E);
  PrintMsgOutput(g_server3E);
  if(response != 0 || id == gPhyId)
  {
    JudgeResponse(response,0x3E);
  }
}

/// <Init>
void ResetAllValue()
{
  long Curtime[8];
  int i;
  
  g_Data.State = MsgTrue;
  
  download_progress_flag = 0;
  transform_data = 0;
  
  putValue(Download,0);
  putValue(FlashRate,0);
  putValue(FlashTime,0);
  ResetFlag = 0;
  
  getMeasurementStartTime(Curtime);
  
  
  for(i = 0;i < 16;i++)
  {
    Serial[i] = 0x00;
  }
  
  
  
  fingerdata[0] = ((Curtime[6] + 1900)/1000)*16 + ((Curtime[6] + 1900)/100)%10 ;//年
  fingerdata[1] = ((((Curtime[6] + 1900)%100)/10)*16) + ((Curtime[6] + 1900)%100)%10;//年
  fingerdata[2] = ((Curtime[5] + 1)/10)*16 + (Curtime[5] + 1)%10;//月
  fingerdata[3] = (Curtime[4]/10)*16 + Curtime[4]%10;//日
  
//  fingerdata[0] = ((((Curtime[6] + 1900)%100)/10)*16) + ((Curtime[6] + 1900)%100)%10;//年
//  fingerdata[1] = ((Curtime[5] + 1)/10)*16 + Curtime[5] + 1%10;//月
//  fingerdata[2] = (Curtime[4]/10)*16 + Curtime[4]%10;//日
  
  
//  for(i = 3;i < 9;i++)
//  {
//    fingerdata[i] = 0xFF;
//  }
  
  FileLen = 0x00180000;
  curDidlength = 0;
  
  
  DriverLength       = 0x4000;
  DriverStartAdress  = 0x0;
  AppLength          = 0x00180000;
  AppStartAdress     = 0xC0000;  //OK
  //AppStartAdress     = 0x240001;//异常场景测试

  /////////////////////////////////////
  _P2Server   = 2000;//P2时间参数
  
  
  _Sid31CheckFlag = 0;
  
  //用于获取当前雷达ID
  
  if(getValue(Rader_ID) == 0)
  {
    gPhyId = 0x772;
    gFunId = 0x7DF;
    gResId = 0x77a;
    putValue(PhyID,gPhyId);
    putValue(ResID,gResId);
  }
  
  if(getValue(Rader_ID) == 1)
  {
    gPhyId = 0x773;
    gFunId = 0x7DF;
    gResId = 0x77b;
    putValue(PhyID,gPhyId);
    putValue(ResID,gResId);
  }  

  if(getValue(Rader_ID) == 2)
  {
    gPhyId = 0x771;
    gFunId = 0x7DF;
    gResId = 0x779;
    putValue(PhyID,gPhyId);
    putValue(ResID,gResId);
  } 
  
  if(getValue(Rader_ID) == 3)
  {
    gPhyId = 0x770;
    gFunId = 0x7DF;
    gResId = 0x778;
    putValue(PhyID,gPhyId);
    putValue(ResID,gResId);
  } 
  
  if(getValue(Rader_ID) == 4)
  {
    gPhyId = getValue(PhyID);
    gFunId = 0x7DF;
    gResId = getValue(ResID);
    
    if(gPhyId == 0 || gResId == 0)
    {
      putValue(PhyID,0x772);
      putValue(ResID,0x77A);
    }
  } 
}

/// <Init>
char HexToChar(char buff)
{
  if((buff >= 0x30) && (buff <= 0x39))
  {
    buff -= 0x30;
  }
  else if((buff >= 0x41) &&(buff <= 0x46))
  {
    buff -= 0x37;
  }
  else if((buff >= 0x61) && (buff <= 0x66))
  {
    buff -= 0x57;
  }
  else
  {
    buff = 0xFF;
  }
  return buff;
}

/// <CRC>
byte crc8CheckSum(long buff[],dword len)
{
  long tmp;
  dword i;
  byte  checksum;
  tmp=0x00;
  for(i = 0;i < len;i++)
  {
    tmp= tmp + buff[i];
  }
  
  checksum = ~((byte)tmp);
  return checksum;
}
