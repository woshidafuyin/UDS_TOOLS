<NAME>
<TUV xml:lang='en-US'>DTC OccurrenceCounter (2 Byte)</TUV>
</NAME>
<QUAL>DTC_OccurrenceCounter_2_Byte</QUAL>
<ENUM oid='105E18E4DB124d3088587F0EA416CF64' temploid='3A6E53825DC1448cA47CE1343B30A803' attrref='_00000285C913C470' v='25'/>
