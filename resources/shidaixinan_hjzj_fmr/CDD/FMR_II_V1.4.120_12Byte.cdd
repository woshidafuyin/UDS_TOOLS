<ENUMDEF id='_00000285C8E30400' oid='15CF06B510DC414081827405B2839901' temploid='9ECCE7FD714B4accBC2CC8FC7A7EADCF' attrcatref='_00000285C92D7CB0' restr='SecurityAccessEmission_related_Trouble_CodesFile_TransferResetIdentificationConfigurationOBD_II_Vehicle_InformationOBD_II_Deeper_Inspection_with_Test_ResultsOBD_II_Controlling_the_SystemOBD_II_Diagnostic_and_Freeze_Frame_DataLink_Control' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Static_Seed</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>This is used to indicate whether or not a static_seed is used or not for non-standard security algorithms.  This value shall always be false if Delay_Timer and Att_Cnt are not supported.</TUV>
</DESC>
<QUAL>Static_Seed</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>False</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>True</TUV>
</ETAG>
</ENUMDEF>
