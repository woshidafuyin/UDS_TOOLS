<NAME>
<TUV xml:lang='en-US'>DTC Root Cause EventId</TUV>
</NAME>
<QUAL>DTC_Root_Cause_EventId</QUAL>
<ENUM oid='E6E57ADD1ACF404f8EDD0585320911D9' temploid='477C4219B5164fe1A1DF1E7937E5537C' attrref='_00000285C913C470' v='28'/>
