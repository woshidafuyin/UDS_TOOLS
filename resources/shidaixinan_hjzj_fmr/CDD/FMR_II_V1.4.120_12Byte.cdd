</NAME>
<DESC>
<TUV xml:lang='en-US'>Only exported if Service $2A with transmissionMode $01 (sendAtSlowRate) is supported.</TUV>
</DESC>
<QUAL>Periodic_Rate_Slow_in_ms</QUAL>
</UNSDEF>
<UNSDEF id='_00000285C931A690' oid='D80B2011DF894d56B556780895B2E2F6' temploid='FBE63A8D027B419394833B66F9950CA4' attrcatref='_00000285C92D7A70' v='100' df='dec'>
