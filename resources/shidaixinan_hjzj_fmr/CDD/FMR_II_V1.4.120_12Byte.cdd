</NAME>
<DESC>
<TUV xml:lang='en-US'>Only exported if Service $2A with transmissionMode $02 (sendAtMediumRate) is supported.</TUV>
</DESC>
<QUAL>Periodic_Rate_Medium_in_ms</QUAL>
</UNSDEF>
<UNSDEF id='_00000285C9357080' oid='F5B11E2DF1BF4e2a9F5E0F23DABA2C34' temploid='FF06A0BADCE348dc983363E67E5D1CB8' attrcatref='_00000285C92D7A70' v='20' df='dec'>
