<IDENT id='_00000285C8D4D7F0' oid='B33C1BD795384cecAA9417E1E3CB6F93' temploid='05E538DACA0B4d399BD96247CA0C38E6' bm='65535'>
<NAME>
<TUV xml:lang='en-US'>DTC OBD</TUV>
</NAME>
<QUAL>DTC_OBD</QUAL>
<ENUM oid='4F953C0BCE354f2cAFDCD6DAB6AF04FC' temploid='17BE1991FFFC4e5eAE5ED0DA168CF27E' attrref='_00000285C913C470' v='29'/>
<CVALUETYPE bl='16' bo='21' enc='uns' sig='0' df='hex' qty='atom' sz='no' minsz='1' maxsz='1'/>
<PVALUETYPE bl='16' bo='21' enc='uns' sig='0' df='hex' qty='atom' sz='no' minsz='1' maxsz='1'/>
